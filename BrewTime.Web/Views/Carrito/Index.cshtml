@model BrewTime.Application.DTOs.CarritoDTO
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<BrewTime.Web.SharedResource> SharedLocalizer

@section Styles {
    <link rel="stylesheet"
          href="~/css/carrito.css"
          asp-append-version="true" />
}

@{
    ViewData["Title"] = SharedLocalizer["Cart_TitleMy"].Value + " " + SharedLocalizer["Cart_TitleWord"].Value;
}

<div class="brew-page">

    <partial name="_Chatbot" />

    <div class="brew-hero">
        <div class="brew-hero-inner">

            <p class="brew-hero-eyebrow">
                BrewTime
            </p>

            <h1 class="brew-titulo">

                @SharedLocalizer["Cart_TitleMy"]

                <em>@SharedLocalizer["Cart_TitleWord"]</em>

            </h1>

            <p class="brew-subtitulo">

                @SharedLocalizer["Cart_Subtitle"]

            </p>

        </div>
    </div>

    <div class="brew-content">

        @if (!Model.Items.Any())
        {
            <div class="brew-empty">

                <span style="font-size:70px">
                    🛒
                </span>

                <h3>
                    @SharedLocalizer["Cart_EmptyTitle"]
                </h3>

                <p>

                    @SharedLocalizer["Cart_EmptyText"]

                </p>

                <a asp-controller="Producto"
                   asp-action="Index"
                   class="btn btn-success">

                    @SharedLocalizer["Cart_ExploreProducts"]

                </a>

            </div>
        }
        else
        {

            <div class="brew-cart-layout">

                <div class="brew-cart-list">
                    @foreach (var item in Model.Items)
                    {

                        <div class="brew-cart-card">

                            <div class="brew-cart-left">

                                <div class="brew-cart-img">

                                    @if (!string.IsNullOrEmpty(item.Imagen))
                                    {
                                        <img src="@item.Imagen"
                                             alt="@item.Nombre" />
                                    }
                                    else
                                    {
                                        @if (item.EsCombo)
                                        {
                                            <span>🥪</span>
                                        }
                                        else
                                        {
                                            <span>☕</span>
                                        }
                                    }

                                </div>

                                <div>

                                    <h4>

                                        @item.Nombre

                                    </h4>

                                    <p>

                                        ₡@item.PrecioUnitario.ToString("N2")

                                    </p>

                                    <div class="brew-tags">

                                        <span class="brew-tag brew-tag-categoria">
                                            @(item.EsCombo ? SharedLocalizer["Combos"].Value : SharedLocalizer["Cart_TagBeverages"].Value)
                                        </span>

                                        <span class="brew-tag brew-tag-estado">
                                            @SharedLocalizer["Activo"]
                                        </span>

                                    </div>

                                </div>

                            </div>

                            <div class="brew-cart-right">

                                <form asp-action="ActualizarCantidad"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="carritoId"
                                           value="@item.CarritoId" />

                                    <div class="brew-qty">

                                        <button type="submit"
                                                name="cantidad"
                                                value="@(item.Cantidad-1)"
                                                class="qty-btn">

                                            -

                                        </button>

                                        <span>

                                            @item.Cantidad

                                        </span>

                                        <button type="submit"
                                                name="cantidad"
                                                value="@(item.Cantidad+1)"
                                                class="qty-btn">

                                            +

                                        </button>

                                    </div>

                                </form>

                                <h5>

                                    ₡@item.Subtotal.ToString("N2")

                                </h5>

                                <form asp-action="Eliminar"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="carritoId"
                                           value="@item.CarritoId" />

                                    <button class="btn btn-danger">

                                        🗑

                                    </button>

                                </form>

                            </div>

                        </div>

                    }

                </div>

                <div class="brew-summary-column">

                    <div class="brew-summary">

                        <h3>

                            @SharedLocalizer["Cart_Summary"]

                        </h3>

                        <hr />

                        <div class="d-flex justify-content-between">

                            <span>

                                Subtotal

                            </span>

                            <strong>

                                ₡@Model.Subtotal.ToString("N2")

                            </strong>

                        </div>

                        <div class="d-flex justify-content-between">

                            <span>

                                IVA

                            </span>

                            <strong>

                                ₡@Model.IVA.ToString("N2")

                            </strong>

                        </div>

                        <div class="d-flex justify-content-between mt-3">

                            <span>

                                Total

                            </span>

                            <strong>

                                ₡@Model.Total.ToString("N2")

                            </strong>

                        </div>

                        <hr />

                        <form asp-action="Vaciar"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button class="btn btn-outline-danger w-100 mb-2">

                                @SharedLocalizer["Cart_EmptyCartBtn"]

                            </button>

                        </form>

                        <a asp-controller="Pedido"
                           asp-action="Registrar"
                           class="btn btn-success w-100">

                            @SharedLocalizer["Cart_ContinueOrder"]

                        </a>

                    </div>

                </div>

            </div>

        }

    </div>

</div>