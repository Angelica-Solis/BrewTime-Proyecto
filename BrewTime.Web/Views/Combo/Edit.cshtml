@model BrewTime.Application.DTOs.ComboFormDTO
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<BrewTime.Web.SharedResource> SharedLocalizer

@{
    ViewData["Title"] = SharedLocalizer["Title_EditCombo"];
    var productosDisponibles = ViewBag.ProductosDisponibles as List<BrewTime.Application.DTOs.ComboProductoFormDTO>
                              ?? new List<BrewTime.Application.DTOs.ComboProductoFormDTO>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/combo.css" asp-append-version="true" />
}

<div class="brew-page">

    <div class="brew-hero">
        <div class="brew-hero-inner">
            <p class="brew-hero-eyebrow">@SharedLocalizer["BrewTimeAdministration"]</p>
            <h1 class="brew-titulo">@SharedLocalizer["EditTitle"] <em>@SharedLocalizer["EditItalicCombo"]</em></h1>
            <p class="brew-subtitulo">@SharedLocalizer["HeroSubtitleEditCombo"]</p>
            <div class="brew-hero-line"><span></span><i>@SharedLocalizer["ComboEdition"]</i><span></span></div>
        </div>
    </div>

    <div class="brew-content">
        <a asp-action="Maintenance" class="brew-btn-volver"> @SharedLocalizer["BackToMaintenance"]</a>

        <div class="brew-form-card">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input asp-for="ComboID" type="hidden" />

                <div class="brew-form-row">
                    <div class="brew-form-group">
                        <label asp-for="Nombre" class="brew-form-label">@SharedLocalizer["LabelName"]</label>
                        <input asp-for="Nombre" class="brew-form-input" />
                        <span asp-validation-for="Nombre" class="brew-form-error"></span>
                    </div>
                    <div class="brew-form-group">
                        <label asp-for="CategoriaID" class="brew-form-label">@SharedLocalizer["LabelCategory"]</label>
                        <select asp-for="CategoriaID" asp-items="ViewBag.Categorias" class="brew-form-input">
                            <option value="">@SharedLocalizer["SelectCategoryOption"]</option>
                        </select>
                        <span asp-validation-for="CategoriaID" class="brew-form-error"></span>
                    </div>
                </div>

                <div class="brew-form-row">
                    <div class="brew-form-group">
                        <label asp-for="PrecioEspecial" class="brew-form-label">@SharedLocalizer["LabelSpecialPrice"]</label>
                        <input asp-for="PrecioEspecial" type="number" step="50" min="0" class="brew-form-input" />
                        <span asp-validation-for="PrecioEspecial" class="brew-form-error"></span>
                    </div>
                    <div class="brew-form-group brew-form-check-group" style="justify-content:flex-end;padding-top:1.6rem;">
                        <input asp-for="Activo" type="checkbox" class="brew-form-check" />
                        <label asp-for="Activo" class="brew-form-label">@SharedLocalizer["LabelComboActive"]</label>
                    </div>
                </div>

                <div class="brew-form-group">
                    <label asp-for="Descripcion" class="brew-form-label">@SharedLocalizer["LabelDescription"]</label>
                    <textarea asp-for="Descripcion" class="brew-form-input brew-form-textarea"></textarea>
                    <span asp-validation-for="Descripcion" class="brew-form-error"></span>
                </div>

                <div class="brew-form-group">
                    <label asp-for="Imagen" class="brew-form-label">@SharedLocalizer["LabelComboImage"]</label>

                    @if (!string.IsNullOrWhiteSpace(Model.RutaImagenActual))
                    {
                        <div class="brew-current-images">
                            <div class="brew-current-image">
                                <img src="@Model.RutaImagenActual" alt="@Model.Nombre" />
                                <span>
                                    <input asp-for="EliminarImagen" class="brew-form-check" id="eliminarImagenCheck" />
                                    <label for="eliminarImagenCheck">@SharedLocalizer["BtnDeleteCurrentImage"]</label>
                                </span>
                            </div>
                        </div>
                    }

                    <div class="brew-upload-box">
                        <span class="brew-upload-icon"><i class="bi bi-camera"></i></span>
                        <div class="brew-upload-copy">
                            <strong>@SharedLocalizer["UploadImageTitle"]</strong>
                            <span>@SharedLocalizer["ReplaceImageHint"]</span>
                        </div>
                        <input asp-for="Imagen" type="file" accept="image/png,image/jpeg,image/webp"
                               class="brew-file-input" onchange="previsualizarImagen(this)" />
                    </div>

                    <div class="brew-image-preview" id="imagenPreviewBox" hidden>
                        <img id="imagenPreview" src="" alt="" />
                        <span id="imagenPreviewNombre"></span>
                    </div>

                    <span asp-validation-for="Imagen" class="brew-form-error"></span>
                </div>                @* ── Selección de productos ── *@
                <div class="brew-form-group">
                    <label class="brew-form-label">@SharedLocalizer["LabelComboProducts"]</label>
                    <small style="color:var(--text-soft);font-size:0.78rem;display:block;margin-bottom:0.75rem;">
                        @SharedLocalizer["InstructionEditProducts"]
                    </small>

                    <div class="brew-productos-grid">
                        @for (int i = 0; i < productosDisponibles.Count; i++)
                        {
                            var p = productosDisponibles[i];
                            var mostrarCantidad = p.Seleccionado ? "block" : "none";
                            <div class="brew-producto-item @(p.Seleccionado ? "brew-producto-activo" : "")">
                                <input type="hidden"
                                       name="ProductosSeleccionados[@i].ProductoID"
                                       value="@p.ProductoID" />
                                <input type="hidden"
                                       name="ProductosSeleccionados[@i].NombreProducto"
                                       value="@p.NombreProducto" />

                                <label class="brew-producto-check-label">
                                    <input type="checkbox"
                                           name="ProductosSeleccionados[@i].Seleccionado"
                                           value="true"
                                           class="brew-form-check brew-producto-check"
                                    @(p.Seleccionado ? "checked" : "")
                                           onchange="toggleCantidad(this, 'cantidad-@i')" />
                                    @p.NombreProducto
                                </label>

                                <div class="brew-cantidad-wrap" id="cantidad-@i" style="display:@mostrarCantidad;">
                                    <label class="brew-form-label" style="font-size:0.65rem;">@SharedLocalizer["LabelQuantity"]</label>
                                    <input type="number"
                                           name="ProductosSeleccionados[@i].Cantidad"
                                           value="@p.Cantidad"
                                           min="1" max="10"
                                           class="brew-form-input brew-cantidad-input" />
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="brew-form-footer">
                    <a asp-action="Maintenance" class="brew-btn-volver">@SharedLocalizer["BtnCancel"]</a>
                    <button type="submit" class="brew-btn-nuevo">@SharedLocalizer["BtnSaveChanges"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function toggleCantidad(checkbox, cantidadId) {
            const wrap = document.getElementById(cantidadId);
            wrap.style.display = checkbox.checked ? 'block' : 'none';
        }

        function previsualizarImagen(input) {
            const box = document.getElementById('imagenPreviewBox');
            const img = document.getElementById('imagenPreview');
            const nombre = document.getElementById('imagenPreviewNombre');

            if (input.files && input.files[0]) {
                const file = input.files[0];
                const reader = new FileReader();
                reader.onload = e => {
                    img.src = e.target.result;
                    nombre.textContent = file.name;
                    box.hidden = false;
                };
                reader.readAsDataURL(file);
            } else {
                img.src = '';
                nombre.textContent = '';
                box.hidden = true;
            }
        }
    </script>
}