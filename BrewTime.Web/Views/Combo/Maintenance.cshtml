@model IEnumerable<BrewTime.Application.DTOs.ComboDTO>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<BrewTime.Web.SharedResource> SharedLocalizer

@{
    var inactivos = ViewBag.Inactivos as IEnumerable<BrewTime.Application.DTOs.ComboDTO>
                    ?? Enumerable.Empty<BrewTime.Application.DTOs.ComboDTO>();
    ViewData["Title"] = SharedLocalizer["Title_ComboMaintenance"];
}

@section Styles {
    <link rel="stylesheet" href="~/css/producto.css" asp-append-version="true" />
}

<div class="brew-page">

    <div class="brew-hero">
        <div class="brew-hero-inner">
            <p class="brew-hero-eyebrow">@SharedLocalizer["BrewTimeAdministration"]</p>
            <h1 class="brew-titulo">@SharedLocalizer["MaintenanceTitleBefore"] <em>@SharedLocalizer["MaintenanceTitleItalic"]</em></h1>
            <p class="brew-subtitulo">@SharedLocalizer["HeroSubtitleMaintenance"]</p>
            <div class="brew-hero-line">
                <span></span><i>@SharedLocalizer["CombosManagement"]</i><span></span>
            </div>
        </div>
    </div>

    <div class="brew-content">

        @* Toolbar *@
        <div class="brew-maint-toolbar">
            <a asp-action="Index" class="brew-btn-volver">← @SharedLocalizer["BackToList"]</a>
            <a asp-action="Create" class="brew-btn-nuevo">+ @SharedLocalizer["NewComboBtn"]</a>
        </div>

        @* ── COMBOS ACTIVOS ── *@
        <h2 class="brew-section-title">
            <span class="brew-section-dot activo"></span>
            @SharedLocalizer["ActiveCombos"]
            <span class="brew-section-count">@Model.Count()</span>
        </h2>

        @if (!Model.Any())
        {
            <div class="brew-empty"><span class="brew-empty-icon">☕</span><p>@SharedLocalizer["NoActiveCombos"]</p></div>
        }
        else
        {
            <div class="brew-maint-table-wrap">
                <table class="brew-maint-table">
                    <thead>
                        <tr>
                            <th>@SharedLocalizer["ThName"]</th>
                            <th>@SharedLocalizer["ThCategory"]</th>
                            <th>@SharedLocalizer["ThSpecialPrice"]</th>
                            <th class="text-center">@SharedLocalizer["ThActions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Nombre</td>
                                <td><span class="brew-card-chip">@item.CategoriaNombre</span></td>
                                <td>@item.PrecioEspecial.ToString("C", new System.Globalization.CultureInfo("es-CR"))</td>
                                <td class="brew-maint-actions">
                                    <a asp-action="Edit" asp-route-id="@item.ComboID" class="brew-btn-editar">
                                        <i class="bi bi-pencil"></i> @SharedLocalizer["BtnEdit"]
                                    </a>
                                    <a asp-action="Detail" asp-route-id="@item.ComboID" class="brew-btn-editar">
                                        <i class="bi bi-eye"></i> @SharedLocalizer["BtnViewDetail"]
                                    </a>
                                    @* Formulario para desactivar *@
                                    <form asp-action="ToggleActivo" method="post" style="display:inline">
                                        <input type="hidden" name="id" value="@item.ComboID" />
                                        <button type="button" class="brew-btn-desactivar btn-toggle-combo"
                                                data-nombre="@item.Nombre" data-accion="desactivar">
                                            <i class="bi bi-toggle-on"></i> @SharedLocalizer["BtnDeactivate"]
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @* ── COMBOS INACTIVOS ── *@
        <h2 class="brew-section-title" style="margin-top:2.5rem;">
            <span class="brew-section-dot inactivo"></span>
            @SharedLocalizer["InactiveCombos"]
            <span class="brew-section-count">@inactivos.Count()</span>
        </h2>

        @if (!inactivos.Any())
        {
            <div class="brew-empty"><span class="brew-empty-icon">✓</span><p>@SharedLocalizer["NoInactiveCombos"]</p></div>
        }
        else
        {
            <div class="brew-maint-table-wrap brew-table-inactiva">
                <table class="brew-maint-table">
                    <thead>
                        <tr>
                            <th>@SharedLocalizer["ThName"]</th>
                            <th>@SharedLocalizer["ThCategory"]</th>
                            <th>@SharedLocalizer["ThSpecialPrice"]</th>
                            <th class="text-center">@SharedLocalizer["ThActions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in inactivos)
                        {
                            <tr class="brew-row-inactiva">
                                <td>@item.Nombre</td>
                                <td><span class="brew-card-chip">@item.CategoriaNombre</span></td>
                                <td>@item.PrecioEspecial.ToString("C", new System.Globalization.CultureInfo("es-CR"))</td>
                                <td class="brew-maint-actions">
                                    <a asp-action="Edit" asp-route-id="@item.ComboID" class="brew-btn-editar">
                                        <i class="bi bi-pencil"></i> @SharedLocalizer["BtnEdit"]
                                    </a>
                                    <a asp-action="Detail" asp-route-id="@item.ComboID" class="brew-btn-editar">
                                        <i class="bi bi-eye"></i> @SharedLocalizer["BtnViewDetail"]
                                    </a>
                                    @* Formulario para activar *@
                                    <form asp-action="ToggleActivo" method="post" style="display:inline">
                                        <input type="hidden" name="id" value="@item.ComboID" />
                                        <button type="button" class="brew-btn-activar btn-toggle-combo"
                                                data-nombre="@item.Nombre" data-accion="activar">
                                            <i class="bi bi-toggle-off"></i> @SharedLocalizer["BtnActivate"]
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.querySelectorAll('.btn-toggle-combo').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const form = this.closest('form');
                const nombre = this.getAttribute('data-nombre');
                const accion = this.getAttribute('data-accion');
                const esDesactivar = accion === 'desactivar';

                Swal.fire({
                    title: esDesactivar ? '@SharedLocalizer["SwalTitleDeactivate"]' : '@SharedLocalizer["SwalTitleActivate"]',
                    text: esDesactivar
                        ? `@SharedLocalizer["SwalTextDeactivateBefore"] "${nombre}" @SharedLocalizer["SwalTextDeactivateAfter"]`
                        : `@SharedLocalizer["SwalTextActivateBefore"] "${nombre}" @SharedLocalizer["SwalTextActivateAfter"]`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: esDesactivar ? '#8a2020' : '#243318',
                    cancelButtonColor: '#5a3e28',
                    confirmButtonText: esDesactivar ? '@SharedLocalizer["SwalConfirmDeactivate"]' : '@SharedLocalizer["SwalConfirmActivate"]',
                    cancelButtonText: '@SharedLocalizer["SwalCancel"]',
                    background: '#f0e2cc',
                    color: '#2e1e0e'
                }).then((result) => {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });
    </script>
}