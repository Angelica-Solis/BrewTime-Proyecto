@model IEnumerable<BrewTime.Application.DTOs.ComboDTO>
@using Microsoft.AspNetCore.Mvc.Localization
@using BrewTime.Web
@inject IHtmlLocalizer<SharedResource> SharedLocalizer

@section Styles {
    <link rel="stylesheet" href="~/css/combo.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = SharedLocalizer["Title_Combos"].Value;
}

<div class="brew-page">
    @* Chatbot  *@
    <partial name="_Chatbot" />

    @* Hero banner *@
    <div class="brew-hero">
        <div class="brew-hero-inner">
            <p class="brew-hero-eyebrow">@SharedLocalizer["BrewTimeCafeteria"]</p>
            <h1 class="brew-titulo">@SharedLocalizer["Our"] <em>@SharedLocalizer["CombosItalic"]</em></h1>
            <p class="brew-subtitulo">@SharedLocalizer["HeroSubtitle"]</p>
            <div class="brew-hero-line">
                <span></span>
                <i>@SharedLocalizer["OffersAndSpecialPrices"]</i>
                <span></span>
            </div>
            @if (User.IsInRole("Administrador") || User.IsInRole("Encargado"))
            {
                <div class="brew-hero-actions">
                    <a asp-action="Maintenance" class="brew-btn-admin">
                        @SharedLocalizer["ManageCombos"]
                    </a>
                </div>
            }
        </div>
    </div>

    @* Contenido *@
    <div class="brew-content">

        @if (!Model.Any())
        {
            <div class="brew-grid">
                <div class="brew-empty">
                    <span class="brew-empty-icon"></span>
                    <p>@SharedLocalizer["NoCombosRegisteredYet"]</p>
                </div>
            </div>
        }
        else
        {
            <p class="brew-count">@Model.Count() @SharedLocalizer["CombosAvailableSuffix"]</p>

            <div class="brew-grid">
                @foreach (var item in Model)
                {
                    <div class="brew-card">
                        <div class="brew-card-stripe"></div>
                        @if (!string.IsNullOrWhiteSpace(item.RutaImagen)) { <img src="@item.RutaImagen" class="brew-combo-image" alt="@item.Nombre" /> }<div class="brew-card-body">

                            @* Chip de categoría *@
                            <span class="brew-card-chip">@item.CategoriaNombre</span>

                            @* Nombre del combo *@
                            <p class="brew-card-producto">@item.Nombre</p>

                            @* Descripción *@
                            <p class="brew-card-desc">@item.Descripcion</p>

                            @* Footer *@
                            <div class="brew-card-footer">
                                <span class="brew-badge-tiempo">
                                    @item.PrecioEspecial.ToString("C", new System.Globalization.CultureInfo("es-CR"))
                                </span>
                                <a asp-action="Detail"
                                   asp-route-id="@item.ComboID"
                                   class="brew-btn-detalle">
                                    @SharedLocalizer["ViewDetail"]
                                </a>
                            </div>

                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>