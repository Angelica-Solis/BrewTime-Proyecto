@model IEnumerable<BrewTime.Application.DTOs.PedidoListDTO>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<BrewTime.Web.SharedResource> SharedLocalizer

@section Styles {
    <link rel="stylesheet" href="~/css/usuario.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ListadoPedidoAdmin.css" asp-append-version="true" />
}
@{
    ViewData["Title"] = SharedLocalizer["OrderAdmin_TitlePrefix"].Value + " " + SharedLocalizer["PedidosWord"].Value;
    var estados = ViewBag.Estados as IEnumerable<BrewTime.Application.DTOs.EstadoPedidoDTO> ?? new List<BrewTime.Application.DTOs.EstadoPedidoDTO>();

    string fechaSel = ViewBag.SelectedFecha as string;
    int? estadoSelId = ViewBag.SelectedEstadoId as int?;
    string estadoSelNombre = estadoSelId.HasValue
        ? estados.FirstOrDefault(e => e.EstadoId == estadoSelId.Value)?.Nombre
        : null;
    bool hayFiltrosActivos = !string.IsNullOrEmpty(fechaSel) || estadoSelId.HasValue;
}
<div class="brew-page">
    <section class="brew-hero">
        <div class="brew-hero-inner">
            <p class="brew-hero-eyebrow">@SharedLocalizer["OrderAdmin_Eyebrow"]</p>
            <h1 class="brew-titulo">
                @SharedLocalizer["OrderAdmin_TitlePrefix"] <em>@SharedLocalizer["PedidosWord"]</em>
            </h1>
            <p class="brew-subtitulo">
                @SharedLocalizer["OrderAdmin_Subtitle"]
            </p>
            <div class="brew-hero-line">
                <span></span>
                <i>BrewTime Panel</i>
                <span></span>
            </div>
        </div>
    </section>

    <div class="brew-content">
        <!-- Barra de Filtros -->
        <div class="brew-filter-bar">
            <div class="brew-filter-title">
                <span class="brew-filter-icon"><i class="bi bi-funnel-fill"></i></span> @SharedLocalizer["OrderAdmin_FilterTitle"]
            </div>
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label for="fecha" class="brew-filter-label">@SharedLocalizer["OrderAdmin_FilterDate"]</label>
                    <div class="brew-field-wrap">
                        <i class="bi bi-calendar3"></i>
                        <input type="date" name="fecha" id="fecha" class="form-control" value="@fechaSel" />
                    </div>
                </div>
                <div class="col-md-4">
                    <label for="estadoId" class="brew-filter-label">@SharedLocalizer["OrderAdmin_FilterStatus"]</label>
                    <div class="brew-field-wrap">
                        <i class="bi bi-tag-fill"></i>
                        <select name="estadoId" id="estadoId" class="form-select">
                            <option value="">@SharedLocalizer["OrderAdmin_AllStatuses"]</option>
                            @foreach (var est in estados)
                            {
                                if (estadoSelId.HasValue && estadoSelId.Value == est.EstadoId)
                                {
                                    <option value="@est.EstadoId" selected="selected">@est.Nombre</option>
                                }
                                else
                                {
                                    <option value="@est.EstadoId">@est.Nombre</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-4 brew-filter-actions">
                    <button type="submit" class="filter-btn-apply w-50">
                        <i class="bi bi-search"></i> @SharedLocalizer["OrderAdmin_FilterBtn"]
                    </button>
                    <a asp-action="Index" class="filter-btn-clear w-50">
                        <i class="bi bi-x-circle"></i> @SharedLocalizer["OrderAdmin_ClearBtn"]
                    </a>
                </div>
            </form>
        </div>

        <div class="brew-results-bar">
            <span class="brew-results-count">
                <i class="bi bi-receipt"></i> <strong>@Model.Count()</strong> @SharedLocalizer["PedidosWord"] @SharedLocalizer["OrderAdmin_ResultsFound"]
            </span>
            @if (hayFiltrosActivos)
            {
                <div class="brew-active-filters">
                    @if (!string.IsNullOrEmpty(fechaSel))
                    {
                        <a class="brew-chip" asp-action="Index" asp-route-fecha="" asp-route-estadoId="@estadoSelId">
                            <i class="bi bi-calendar3"></i> @DateTime.Parse(fechaSel).ToString("dd/MM/yyyy")
                            <i class="bi bi-x-circle-fill"></i>
                        </a>
                    }
                    @if (estadoSelId.HasValue)
                    {
                        <a class="brew-chip" asp-action="Index" asp-route-fecha="@fechaSel" asp-route-estadoId="">
                            <i class="bi bi-tag-fill"></i> @estadoSelNombre
                            <i class="bi bi-x-circle-fill"></i>
                        </a>
                    }
                </div>
            }
        </div>

        @if (Model.Any())
        {
            <div class="brew-table-wrapper">
                <div class="brew-table-stripe"></div>
                <table class="brew-table">
                    <thead>
                        <tr>
                            <th>@SharedLocalizer["OrderAdmin_TableNumber"]</th>
                            <th>@SharedLocalizer["ClienteLabel"]</th>
                            <th>@SharedLocalizer["FechaLabel"]</th>
                            <th>@SharedLocalizer["MetodoEntregaLabel"]</th>
                            <th>Total</th>
                            <th>@SharedLocalizer["EstadoLabel"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pedido in Model)
                        {
                            <tr>
                                <td class="brew-td-nombre">
                                    #@pedido.PedidoId
                                </td>
                                <td>
                                    @pedido.ClienteNombre
                                </td>
                                <td>
                                    @pedido.FechaCreacion.ToString("dd/MM/yyyy hh:mm tt")
                                </td>
                                <td>
                                    @pedido.MetodoEntrega
                                </td>
                                <td style="font-weight: 600; color: #1a2712;">
                                    ₡@pedido.Total.ToString("N2")
                                </td>
                                <td>
                                    @{
                                        string badgeClass = "estado-pendiente";
                                        var est = pedido.EstadoNombre.ToLower();
                                        if (est.Contains("prepar")) badgeClass = "estado-preparando";
                                        else if (est.Contains("list")) badgeClass = "estado-listo";
                                        else if (est.Contains("entreg")) badgeClass = "estado-entregado";
                                        else if (est.Contains("cancel")) badgeClass = "estado-cancelado";
                                    }
                                    <span class="order-badge @badgeClass">
                                        @pedido.EstadoNombre
                                    </span>
                                </td>
                                <td>
                                    <a asp-action="Detail"
                                       asp-route-id="@pedido.PedidoId"
                                       class="brew-btn-detalle">
                                        @SharedLocalizer["VerDetalleBtn"]
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="brew-empty">
                @SharedLocalizer["OrderAdmin_NoResults"]
            </div>
        }
    </div>
</div>
