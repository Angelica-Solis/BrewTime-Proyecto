@model IEnumerable<BrewTime.Application.DTOs.PedidoListDTO>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<BrewTime.Web.SharedResource> SharedLocalizer

@section Styles {
    <link rel="stylesheet" href="~/css/usuario.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ListadoPedidoCliente.css" asp-append-version="true" />
}
@{
    ViewData["Title"] = SharedLocalizer["OrderClient_HistoryPrefix"].Value + " " + SharedLocalizer["PedidosWord"].Value;
}
<div class="brew-page">
    <section class="brew-hero">
        <div class="brew-hero-inner">
            <p class="brew-hero-eyebrow">@SharedLocalizer["OrderClient_MyAccount"]</p>
            <h1 class="brew-titulo">
                @SharedLocalizer["OrderClient_HistoryPrefix"] <em>@SharedLocalizer["PedidosWord"]</em>
            </h1>
            <p class="brew-subtitulo">
                @SharedLocalizer["OrderClient_HistorySubtitle"]
            </p>
            <div class="brew-hero-line">
                <span></span>
                <i>BrewTime</i>
                <span></span>
            </div>
        </div>
    </section>
    <div class="brew-content">
        <div class="brew-count">
            @SharedLocalizer["OrderClient_TotalOrders"]: @Model.Count()
        </div>
        @if (Model.Any())
        {
            <div class="brew-table-wrapper">
                <div class="brew-table-stripe"></div>
                <table class="brew-table">
                    <thead>
                        <tr>
                            <th>@SharedLocalizer["OrderAdmin_TableNumber"]</th>
                            <th>@SharedLocalizer["FechaLabel"]</th>
                            <th>@SharedLocalizer["MetodoEntregaLabel"]</th>
                            <th>Total</th>
                            <th>@SharedLocalizer["EstadoLabel"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pedido in Model)
                        {
                            <tr>
                                <td class="brew-td-nombre">
                                    #@pedido.PedidoId
                                </td>
                                <td>
                                    @pedido.FechaCreacion.ToString("dd/MM/yyyy hh:mm tt")
                                </td>
                                <td>
                                    @pedido.MetodoEntrega
                                </td>
                                <td style="font-weight: 600; color: #1a2712;">
                                    ₡@pedido.Total.ToString("N2")
                                </td>
                                <td>
                                    @{
                                        string badgeClass = "estado-pendiente";
                                        var est = pedido.EstadoNombre.ToLower();
                                        if (est.Contains("prepar")) badgeClass = "estado-preparando";
                                        else if (est.Contains("list")) badgeClass = "estado-listo";
                                        else if (est.Contains("entreg")) badgeClass = "estado-entregado";
                                        else if (est.Contains("cancel")) badgeClass = "estado-cancelado";
                                    }
                                    <span class="order-badge @badgeClass">
                                        @pedido.EstadoNombre
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex gap-2">

                                        <a asp-action="Detail"
                                           asp-route-id="@pedido.PedidoId"
                                           class="brew-btn-detalle">
                                            @SharedLocalizer["VerDetalleBtn"]
                                        </a>


                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="brew-empty">
                @SharedLocalizer["OrderClient_NoOrdersYet"]
            </div>
        }
    </div>
</div>
