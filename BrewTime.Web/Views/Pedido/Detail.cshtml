@model BrewTime.Application.DTOs.PedidoDetalleDTO
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<BrewTime.Web.SharedResource> SharedLocalizer
@section Styles {
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/usuario.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pedidoDetalle.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tracking.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = $"{SharedLocalizer["DetalleDelTxt"].Value} {SharedLocalizer["PedidoWord"].Value} #{Model.PedidoId}";
    var mensajeExito = TempData.Peek("Success") as string;
    var esPersonal = User.IsInRole("Administrador") || User.IsInRole("Encargado");
    var pedidoEnCamino = Model.Estado.Equals("En camino", StringComparison.OrdinalIgnoreCase);
}
<div class="brew-page">
    <section class="brew-hero">
        <div class="brew-hero-inner">
            <p class="brew-hero-eyebrow">@SharedLocalizer["OrderDetail_Eyebrow"]</p>
            <h1 class="brew-titulo">
                @SharedLocalizer["PedidoWord"] #<em>@Model.PedidoId</em>
            </h1>
            <p class="brew-subtitulo">
                @SharedLocalizer["OrderDetail_Subtitle"]
            </p>
            <div class="brew-hero-line">
                <span></span>
                <i>@SharedLocalizer["OrderDetail_HeroLine"]</i>
                <span></span>
            </div>
        </div>
    </section>

    <div class="brew-content">
        @{
            int currentStep = 0;
            string estadoTracker = Model.Estado.ToLower();
            if (estadoTracker.Contains("aceptad")) currentStep = 1;
            else if (estadoTracker.Contains("prepar")) currentStep = 2;
            else if (estadoTracker.Contains("camino")) currentStep = 3;
            else if (estadoTracker.Contains("entreg")) currentStep = 4;
        }

        <!-- Stepper de Seguimiento de Pedido -->
        <div class="tracking-stepper-container">
            <h2 class="tracking-stepper-title">
                <span class="polling-loader" id="pollingLoader"></span>
                @SharedLocalizer["Tracking_OrderTracker"]
            </h2>
            
            <div class="tracking-stepper" id="orderStepper">
                <div class="tracking-progress-line" id="progressLine"></div>
                
                <!-- Paso 1: Pendiente de Pago -->
                <div class="step-item @(currentStep >= 0 ? (currentStep == 0 ? "active" : "completed") : "")" data-step="0">
                    <div class="step-icon">
                        <i class="bi bi-wallet2"></i>
                    </div>
                    <div class="step-label">@SharedLocalizer["Tracking_PendingPayment"]</div>
                </div>

                <!-- Paso 2: Aceptada -->
                <div class="step-item @(currentStep >= 1 ? (currentStep == 1 ? "active" : "completed") : "")" data-step="1">
                    <div class="step-icon">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div class="step-label">@SharedLocalizer["Tracking_Accepted"]</div>
                </div>

                <!-- Paso 3: En preparación -->
                <div class="step-item @(currentStep >= 2 ? (currentStep == 2 ? "active" : "completed") : "")" data-step="2">
                    <div class="step-icon">
                        <i class="bi bi-cup-hot"></i>
                    </div>
                    <div class="step-label">@SharedLocalizer["Tracking_Preparing"]</div>
                </div>

                <!-- Paso 4: En camino / Listo -->
                <div class="step-item @(currentStep >= 3 ? (currentStep == 3 ? "active" : "completed") : "")" data-step="3">
                    <div class="step-icon">
                        @if (Model.MetodoEntrega.Contains("Recogida", StringComparison.OrdinalIgnoreCase))
                        {
                            <i class="bi bi-bag-check" id="step4Icon"></i>
                        }
                        else
                        {
                            <i class="bi bi-truck" id="step4Icon"></i>
                        }
                    </div>
                    <div class="step-label" id="step4Label">
                        @(Model.MetodoEntrega.Contains("Recogida", StringComparison.OrdinalIgnoreCase) 
                            ? SharedLocalizer["Tracking_ReadyPickup"].Value 
                            : SharedLocalizer["Tracking_OnTheWay"].Value)
                    </div>
                </div>

                <!-- Paso 5: Entregada -->
                <div class="step-item @(currentStep >= 4 ? (currentStep == 4 ? "active" : "completed") : "")" data-step="4">
                    <div class="step-icon">
                        <i class="bi bi-gift"></i>
                    </div>
                    <div class="step-label">@SharedLocalizer["Tracking_Delivered"]</div>
                </div>
            </div>
        </div>

        <div class="brew-detail-card">
            <!-- Header -->
            <div class="brew-detail-header">
                <h2 class="brew-detail-title">@SharedLocalizer["OrderDetail_InfoTitle"]</h2>
                @{
                    string badgeClass = "estado-pendiente";
                    var est = Model.Estado.ToLower();
                    if (est.Contains("prepar")) badgeClass = "estado-preparando";
                    else if (est.Contains("list")) badgeClass = "estado-listo";
                    else if (est.Contains("entreg")) badgeClass = "estado-entregado";
                    else if (est.Contains("cancel")) badgeClass = "estado-cancelado";
                }
                <span class="order-badge @badgeClass">
                    @Model.Estado
                </span>
            </div>

            <!-- Body -->
            <div class="brew-detail-body">
                <div class="brew-meta-grid">
                    <div class="brew-meta-item">
                        <div class="brew-meta-label">@SharedLocalizer["OrderDetail_PurchaseDate"]</div>
                        <div class="brew-meta-value">@Model.Fecha.ToString("dd/MM/yyyy hh:mm tt")</div>
                    </div>
                    <div class="brew-meta-item">
                        <div class="brew-meta-label">@SharedLocalizer["ClienteLabel"]</div>
                        <div class="brew-meta-value">@Model.ClienteNombre</div>
                    </div>
                    <div class="brew-meta-item">
                        <div class="brew-meta-label">@SharedLocalizer["CorreoLabel"]</div>
                        <div class="brew-meta-value">@Model.ClienteCorreo</div>
                    </div>
                    <div class="brew-meta-item">
                        <div class="brew-meta-label">@SharedLocalizer["OrderDetail_AssignedManager"]</div>
                        <div class="brew-meta-value">@Model.Encargado</div>
                    </div>
                    <div class="brew-meta-item">
                        <div class="brew-meta-label">@SharedLocalizer["MetodoEntregaLabel"]</div>
                        <div class="brew-meta-value">@Model.MetodoEntrega</div>
                    </div>
                    <div class="brew-meta-item">
                        <div class="brew-meta-label">@SharedLocalizer["MetodoPagoLabel"]</div>
                        <div class="brew-meta-value">@Model.MetodoPago</div>
                    </div>
                </div>

                <hr style="border-color: rgba(201,149,106,0.25); margin: 2rem 0;" />

                <h3 class="brew-detail-title" style="color: #1a2712; margin-bottom: 1rem; font-size: 1.1rem;">@SharedLocalizer["OrderDetail_ProductsInOrder"]</h3>

                <div class="table-responsive">
                    <table class="brew-detail-table">
                        <thead>
                            <tr>
                                <th>@SharedLocalizer["OrderDetail_TableProductCombo"]</th>
                                <th class="text-end">@SharedLocalizer["PrecioLabel"]</th>
                                <th class="text-center">@SharedLocalizer["CantidadLabel"]</th>
                                <th class="text-end">Subtotal</th>
                                <th class="text-end">@SharedLocalizer["ImpuestoLabel"]</th>
                                <th>@SharedLocalizer["ObservacionesLabel"]</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.Detalles)
                            {
                                <tr>
                                    <td class="brew-producto">
                                        @item.Producto
                                    </td>

                                    <td class="text-end">
                                        ₡@item.Precio.ToString("N2")
                                    </td>

                                    <td class="text-center">
                                        @item.Cantidad
                                    </td>

                                    <td class="text-end">
                                        ₡@item.Subtotal.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        ₡@item.Impuesto.ToString("N2")
                                    </td>

                                    <td class="brew-observacion">
                                        @(string.IsNullOrWhiteSpace(item.Observaciones)
                                            ? SharedLocalizer["NingunaTxt"].Value
                                            : item.Observaciones)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Totales -->
                <div class="brew-summary-box">

                    <div class="summary-row">
                        <span>Subtotal</span>
                        <span>₡@Model.Subtotal.ToString("N2")</span>
                    </div>

                    <div class="summary-row">
                        <span>@SharedLocalizer["ImpuestoLabel"]</span>
                        <span>₡@Model.Impuesto.ToString("N2")</span>
                    </div>

                    <div class="summary-row">
                        <span>@SharedLocalizer["CostoEnvioLabel"]</span>
                        <span>₡@Model.CostoEnvio.ToString("N2")</span>
                    </div>

                    <div class="summary-row total">
                        <span>Total</span>
                        <span>₡@Model.Total.ToString("N2")</span>
                    </div>

                </div>
            </div>
        </div>

        <div class="mt-3 mb-5">
            <a asp-action="Index"
               class="brew-back-btn">
                <i class="bi bi-arrow-left"></i>
                @SharedLocalizer["VolverAlListado"]
            </a>

            @if (Model.Estado.Equals(
            "Pendiente de pago",
            StringComparison.OrdinalIgnoreCase))
            {
                <a asp-action="Pago"
                   asp-route-id="@Model.PedidoId"
                   class="btn btn-success">
                    @SharedLocalizer["OrderDetail_PayOrder"]
                </a>
            }

            @if (pedidoEnCamino)
            {
                <form asp-action="Entregar" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="pedidoId" value="@Model.PedidoId" />

                    <button type="submit" class="btn @(esPersonal ? "btn-success" : "btn-entrega-cliente")">
                        <i class="bi @(esPersonal ? "bi-check2-circle" : "bi-bag-check")"></i>

                        @if (esPersonal)
                        {
                            @SharedLocalizer["OrderDetail_MarkDelivered"]
                        }
                        else
                        {
                            @SharedLocalizer["OrderDetail_ReceivedOrder"]
                        }
                    </button>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @if (!string.IsNullOrWhiteSpace(mensajeExito))
    {
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                const mensaje = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(mensajeExito));

                Swal.fire({
                    title: "@SharedLocalizer["OrderDetail_SwalRegisteredTitle"].Value",
                    text: mensaje,
                    icon: "success",
                    confirmButtonText: "@SharedLocalizer["AceptarBtn"].Value",
                    confirmButtonColor: "#1f4a2e",
                    allowOutsideClick: false
                });
            });
        </script>
    }

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const pedidoId = @Model.PedidoId;
            const pollingLoader = document.getElementById("pollingLoader");
            const progressLine = document.getElementById("progressLine");
            const stepItems = document.querySelectorAll(".step-item");
            const statusBadge = document.querySelector(".order-badge");
            const step4Icon = document.getElementById("step4Icon");
            const step4Label = document.getElementById("step4Label");

            // Traduccines para el paso 4 dinámico
            const txtReadyPickup = "@SharedLocalizer["Tracking_ReadyPickup"].Value";
            const txtOnTheWay = "@SharedLocalizer["Tracking_OnTheWay"].Value";

            function updateProgressLine(stepIndex) {
                const totalSteps = stepItems.length;
                let pct = 0;
                if (stepIndex > 0) {
                    pct = (stepIndex / (totalSteps - 1)) * 100;
                }
                
                const isMobile = window.innerWidth <= 768;
                if (isMobile) {
                    progressLine.style.width = "4px";
                    progressLine.style.height = `${pct}%`;
                    progressLine.style.transform = "scaleX(1)";
                } else {
                    progressLine.style.height = "4px";
                    progressLine.style.transform = `scaleX(${pct / 100})`;
                    progressLine.style.width = "auto";
                }
            }

            let currentStep = @currentStep;
            updateProgressLine(currentStep);

            window.addEventListener("resize", () => {
                updateProgressLine(currentStep);
            });

            function getStepIndex(estadoNombre) {
                const est = estadoNombre.toLowerCase();
                if (est.includes("pendiente")) return 0;
                if (est.includes("aceptad")) return 1;
                if (est.includes("prepar")) return 2;
                if (est.includes("camino")) return 3;
                if (est.includes("entreg")) return 4;
                return -1;
            }

            function updateStepperUI(stepIndex) {
                if (stepIndex === -1) return;
                currentStep = stepIndex;

                stepItems.forEach(item => {
                    const step = parseInt(item.getAttribute("data-step"));
                    item.className = "step-item";

                    if (step === stepIndex) {
                        item.classList.add("active");
                    } else if (step < stepIndex) {
                        item.classList.add("completed");
                    }
                });

                updateProgressLine(stepIndex);
            }

            function checkStatus() {
                pollingLoader.classList.add("active");

                fetch(`/Pedido/GetStatusJson/${pedidoId}`)
                    .then(response => {
                        if (!response.ok) throw new Error("Error en la petición");
                        return response.json();
                    })
                    .then(data => {
                        pollingLoader.classList.remove("active");
                        
                        if (statusBadge && data.estado) {
                            statusBadge.textContent = data.estado;
                            
                            statusBadge.className = "order-badge";
                            const est = data.estado.toLowerCase();
                            if (est.includes("prepar")) statusBadge.classList.add("estado-preparando");
                            else if (est.includes("list")) statusBadge.classList.add("estado-listo");
                            else if (est.includes("entreg")) statusBadge.classList.add("estado-entregado");
                            else if (est.includes("cancel")) statusBadge.classList.add("estado-cancelado");
                            else statusBadge.classList.add("estado-pendiente");
                        }

                        // Actualizar icono y texto del paso 4 dinámicamente si es necesario
                        if (data.metodoEntrega) {
                            const isPickup = data.metodoEntrega.toLowerCase().includes("recogida");
                            if (isPickup) {
                                if (step4Icon) step4Icon.className = "bi bi-bag-check";
                                if (step4Label) step4Label.textContent = txtReadyPickup;
                            } else {
                                if (step4Icon) step4Icon.className = "bi bi-truck";
                                if (step4Label) step4Label.textContent = txtOnTheWay;
                            }
                        }

                        const newStep = getStepIndex(data.estado);
                        if (newStep !== -1 && newStep !== currentStep) {
                            updateStepperUI(newStep);
                            
                            // Recargar si finalizó el pedido o cambió el estado de pago
                            if (newStep === 4 || (currentStep === 0 && newStep > 0)) {
                                setTimeout(() => { window.location.reload(); }, 1500);
                            }
                        }
                    })
                    .catch(err => {
                        console.error("Error al consultar el estado:", err);
                        pollingLoader.classList.remove("active");
                    });
            }

            const estadoInicial = "@Model.Estado".toLowerCase();
            if (!estadoInicial.includes("entreg") && !estadoInicial.includes("cancel")) {
                setInterval(checkStatus, 10000);
            }
        });
    </script>
}
