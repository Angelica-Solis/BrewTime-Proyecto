@using Microsoft.AspNetCore.Mvc.Localization
@using BrewTime.Web
@model ICollection<ProcesoPreparacionListadoDTO>

@inject IHtmlLocalizer<SharedResource> SharedLocalizer

@section Styles {
    <link rel="stylesheet" href="~/css/procesoPreparacion.css" asp-append-version="true" />
}
@{
    ViewData["Title"] = SharedLocalizer["TituloPestana"].Value;
}

<div class="brew-page">
    <div class="brew-hero">
        <div class="brew-hero-inner">
            <p class="brew-hero-eyebrow">@SharedLocalizer["EyebrowCafeteria"]</p>



            <h1 class="brew-titulo">@SharedLocalizer["TituloPrincipal"]</h1>

            <p class="brew-subtitulo">@SharedLocalizer["Subtitulo"]</p>
            <div class="brew-hero-line">
                <span></span>
                <i>@SharedLocalizer["EstacionesTiempos"]</i>
                <span></span>
            </div>


            @if (User.IsInRole("Administrador") || User.IsInRole("Encargado"))
            {
                <div class="brew-hero-actions">
                    <a asp-action="Maintenance" class="brew-btn-admin">
                        @SharedLocalizer["BtnAdministrar"]
                    </a>
                </div>
            }
        </div>
    </div>

    <div class="brew-content">
        @if (!Model.Any())
        {
            <div class="brew-grid">
                <div class="brew-empty">
                    <p>@SharedLocalizer["SinPasosRegistrados"]</p>
                </div>
            </div>
        }
        else
        {


            <p class="brew-count">@SharedLocalizer["ConteoPasos", Model.Count]</p>
            <div class="brew-grid">
                @foreach (var item in Model)
                {
                    <div class="brew-card">
                        <div class="brew-card-stripe"></div>
                        <div class="brew-card-body">
                            <span class="brew-card-chip">@SharedLocalizer["EtiquetaProducto"]</span>
                            <p class="brew-card-producto">@item.NombreProducto</p>
                            <p class="brew-card-paso">


                                @SharedLocalizer["PasosPreparacion", item.CantidadProcesos]
                            </p>
                            <div class="brew-card-footer">
                                <a class="brew-btn-detalle"
                                   asp-action="Detail"
                                   asp-route-id="@item.ProductoId">
                                    @SharedLocalizer["BtnVerDetalle"]
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
    @* Chatbot  *@
    <partial name="_Chatbot" />
</div>