@model IEnumerable<BrewTime.Application.DTOs.ProcesoPreparacionListadoDTO>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<BrewTime.Web.SharedResource> SharedLocalizer

@{
    ViewData["Title"] = SharedLocalizer["MantProcesosTitulo"].Value;
}
@section Styles {
    <link rel="stylesheet" href="~/css/procesoPreparacion.css" asp-append-version="true" />
}

<div class="brew-page">

    <div class="brew-hero">
        <div class="brew-hero-inner">
            <p class="brew-hero-eyebrow">@SharedLocalizer["AdminEyebrow"]</p>
            <h1 class="brew-titulo">@SharedLocalizer["MantenimientoDe"] <em>@SharedLocalizer["ProcesosPreparacionEm"]</em></h1>
            <p class="brew-subtitulo">@SharedLocalizer["DescMantProcesos"]</p>
            <div class="brew-hero-line">
                <span></span>
                <i>@SharedLocalizer["GestionProcesosLabel"]</i>
                <span></span>
            </div>
        </div>
    </div>

    <div class="brew-content">

        <div class="brew-mant-header">
            <a asp-action="Index"  class="brew-btn-volver-mant">
                ← @SharedLocalizer["VolverBtn"]
            </a>
            <a asp-action="Create" class="brew-btn-nuevo">
                + @SharedLocalizer["NuevoProcesoBtn"]
            </a>
        </div>

        <div class="brew-mant-title-row">
            <span class="brew-mant-dot"></span>
            <h2 class="brew-mant-title">@SharedLocalizer["ProcesosRegistradosTitulo"]</h2>
            <span class="brew-mant-count">@(Model?.Count() ?? 0)</span>
        </div>

        <div class="brew-table-container">
            <table class="brew-table">
                <thead>
                    <tr>
                        <th style="width:60px;">#</th>
                        <th>@SharedLocalizer["ProductoCol"]</th>
                        <th class="text-center">@SharedLocalizer["CantEstacionesCol"]</th>
                        <th class="text-center" style="width:260px;">@SharedLocalizer["AccionesCol"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int i = 1;
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@i</td>
                                <td>@item.NombreProducto</td>
                                <td class="text-center">
                                    <span class="brew-badge-cantidad">@item.CantidadProcesos</span>
                                </td>
                                <td>
                                    <div class="brew-actions-cell">
                                        <a asp-action="DetailAdmin"
                                           asp-route-id="@item.ProductoId"
                                           class="brew-btn-detalle-table">
                                            <i class="bi bi-eye"></i> @SharedLocalizer["DetalleBtn"]
                                        </a>
                                        <a asp-action="Edit"
                                           asp-route-id="@item.ProductoId"
                                           class="brew-btn-editar-table">
                                            <i class="bi bi-pencil-square"></i> @SharedLocalizer["EditarBtn"]
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            i++;
                        }
                    }
                    else
                    {
                        <tr class="brew-empty-row">
                            <td colspan="4">
                                @SharedLocalizer["NoHayProcesosMsj"]
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @if (TempData["Success"] != null)
    {
        <script>
            // Alerta clásica de éxito (puedes unificarla con el toast si prefieres)
            Swal.fire({
                icon: 'success',
                title: '@SharedLocalizer["ExitoAlerta"].Value',
                text: '@TempData["Success"]',
                confirmButtonText: '@SharedLocalizer["AceptarBtn"].Value'
            });

            // Toast de éxito
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: '@TempData["Success"]',
                showConfirmButton: false,
                timer: 2500,
                timerProgressBar: true
            });
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: '@SharedLocalizer["ErrorAlerta"].Value',
                text: '@TempData["Error"]',
                confirmButtonText: '@SharedLocalizer["AceptarBtn"].Value'
            });
        </script>
    }
}