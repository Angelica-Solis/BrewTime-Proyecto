@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<BrewTime.Web.SharedResource> SharedLocalizer

@{
    ViewData["Title"] = SharedLocalizer["InicioTitulo"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tracking.css" asp-append-version="true" />
}

<div class="home-page">
    @* Chatbot  *@
    <partial name="_Chatbot" />

    @* Pedido Activo Widget *@
    @if (ViewBag.PedidosActivos != null)
    {
        var pedidosActivos = (List<BrewTime.Application.DTOs.PedidoListDTO>)ViewBag.PedidosActivos;
        if (pedidosActivos.Any())
        {
            var principalActive = pedidosActivos.First();
            string badgeClass = "status-badge-aceptada";
            var est = principalActive.EstadoNombre.ToLower();
            if (est.Contains("prepar")) badgeClass = "status-badge-preparando";
            else if (est.Contains("camino")) badgeClass = "status-badge-camino";
            
            <div class="active-order-widget">
                <div class="active-order-info">
                    <div class="active-order-icon-container">
                        <i class="bi bi-cup-hot active-order-icon"></i>
                    </div>
                    <div class="active-order-details">
                        <h3 class="active-order-title">
                            @SharedLocalizer["Tracking_ActiveOrder"]
                            <span class="active-order-status-badge @badgeClass">@principalActive.EstadoNombre</span>
                        </h3>
                        <p class="active-order-subtitle">
                            <strong>#@principalActive.PedidoId</strong> - @principalActive.FechaCreacion.ToString("dd/MM/yyyy hh:mm tt")
                        </p>
                    </div>
                </div>
                <div class="active-order-action">
                    <a href="/Pedido/Detail/@principalActive.PedidoId" class="btn-track-active">
                        <i class="bi bi-clock-history"></i>
                        @SharedLocalizer["Tracking_FollowOrder"]
                    </a>
                </div>
            </div>
        }
    }

    @* Hero  *@
    <div class="home-hero">
        <div class="home-hero-inner">
            <p class="home-hero-eyebrow">@SharedLocalizer["HeroEyebrow"]</p>
            <h1 class="home-hero-titulo">
                @SharedLocalizer["BienvenidoA"] <br>
                <em>Brew Time</em>
            </h1>
            <p class="home-hero-subtitulo">
                @SharedLocalizer["HeroSub1"]<br />
                @SharedLocalizer["HeroSub2"]
            </p>
            <a href="/producto" class="home-hero-cta">@SharedLocalizer["VerMenuCompleto"]</a>
            <div class="home-hero-line">
                <span></span>
                <i>@SharedLocalizer["HeroLineTag"]</i>
                <span></span>
            </div>
        </div>
    </div>

    <div class="section-divider" style="margin-top:2.5rem;"><hr /></div>
    <div class="home-about">

        <div class="home-about-card">
            <span>@SharedLocalizer["NosotrosBadge"]</span>

            <h2>@SharedLocalizer["MasQueBebida"]</h2>

            <p>
                @SharedLocalizer["NosotrosTexto"]
            </p>
        </div>

        <div class="home-about-card">
            <span>BREW TIME</span>

            <h2>@SharedLocalizer["QueNosHaceDiferentes"]</h2>

            <ul>
                <li>@SharedLocalizer["Diff1"]</li>
                <li>@SharedLocalizer["Diff2"]</li>
                <li>@SharedLocalizer["Diff3"]</li>
                <li>@SharedLocalizer["Diff4"]</li>
                <li>@SharedLocalizer["Diff5"]</li>
            </ul>
        </div>

    </div>
    <div class="section-divider" style="margin-top:2.5rem;"><hr /></div>

    <div class="home-history">

        <div class="home-history-year">
            <span>@SharedLocalizer["DesdeBadge"]</span>
            <h2>2025</h2>
        </div>

        <div class="home-history-info">

            <h3>@SharedLocalizer["HistoriaTitulo"]</h3>

            <p>
                @SharedLocalizer["HistoriaTexto"]
            </p>

            <div class="home-location">
                📍 San José, Costa Rica
            </div>

        </div>

    </div>
    <div class="section-divider" style="margin-top:2.5rem;"><hr /></div>

    @* Carrusel *@
    <div class="home-carrusel">
        <div class="home-carrusel-header">
            <div>
                <p class="home-menu-eyebrow">@SharedLocalizer["LoMasPedido"]</p>
                <h2 class="home-menu-titulo" style="margin-bottom:0;">@SharedLocalizer["EstrellasTemporada"]</h2>
            </div>
            <div class="home-carrusel-nav">
                <button class="home-carrusel-btn" id="brew-prev" aria-label="@SharedLocalizer["BtnAnterior"]">&#8592;</button>
                <button class="home-carrusel-btn" id="brew-next" aria-label="@SharedLocalizer["BtnSiguiente"]">&#8594;</button>
            </div>
        </div>
        <div class="home-carrusel-viewport">
            <div class="home-carrusel-track" id="brew-track">

                @* Items del Carrusel *@
                <div class="home-carrusel-item">
                    <div class="home-card">
                        <div class="home-card-stripe"></div>
                        <div class="home-card-img-wrap">
                            <img src="~/images/productos/Bubble Tea Original_BubbleTea.png" alt="Bubble Tea Original" />
                        </div>
                        <div class="home-card-body">
                            <span class="home-card-cat">@SharedLocalizer["CatBubbleTea"]</span>
                            <p class="home-card-nombre">Original Bubble Tea</p>
                            <p class="home-card-precio">₡2,500</p>
                        </div>
                    </div>
                </div>
                <div class="home-carrusel-item">
                    <div class="home-card">
                        <div class="home-card-stripe"></div>
                        <div class="home-card-img-wrap">
                            <img src="~/images/productos/CoffeeBoba _Bubble tea.png" alt="Coffee Boba" />
                        </div>
                        <div class="home-card-body">
                            <span class="home-card-cat">@SharedLocalizer["CatBubbleTea"]</span>
                            <p class="home-card-nombre">Coffee Boba</p>
                            <p class="home-card-precio">₡3,000</p>
                        </div>
                    </div>
                </div>
                <div class="home-carrusel-item">
                    <div class="home-card">
                        <div class="home-card-stripe"></div>
                        <div class="home-card-img-wrap">
                            <img src="~/images/productos/IcedMocha_Café.png" alt="Iced Mocha" />
                        </div>
                        <div class="home-card-body">
                            <span class="home-card-cat">@SharedLocalizer["CatCafe"]</span>
                            <p class="home-card-nombre">Iced Mocha</p>
                            <p class="home-card-precio">₡2,700</p>
                        </div>
                    </div>
                </div>
                <div class="home-carrusel-item">
                    <div class="home-card">
                        <div class="home-card-stripe"></div>
                        <div class="home-card-img-wrap">
                            <img src="~/images/productos/Bubble Tea Matcha_BubbleTea.png" alt="Matcha Bubble Tea" />
                        </div>
                        <div class="home-card-body">
                            <span class="home-card-cat">@SharedLocalizer["CatBubbleTea"]</span>
                            <p class="home-card-nombre">Matcha Bubble Tea</p>
                            <p class="home-card-precio">₡2,800</p>
                        </div>
                    </div>
                </div>
                <div class="home-carrusel-item">
                    <div class="home-card">
                        <div class="home-card-stripe"></div>
                        <div class="home-card-img-wrap">
                            <img src="~/images/productos/OreoBoba_Bubble tea.png" alt="Oreo Boba" />
                        </div>
                        <div class="home-card-body">
                            <span class="home-card-cat">@SharedLocalizer["CatBubbleTea"]</span>
                            <p class="home-card-nombre">Oreo Boba</p>
                            <p class="home-card-precio">₡3,000</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="home-carrusel-dots" id="brew-dots"></div>
    </div>

    <div class="home-divider" style="margin-top:2.5rem;"><hr /></div>

    @* Sección Bubble Tea *@
    <div class="section-divider"></div>

    <div class="home-divider">
        <div class="home-section-header">
            <h2 class="home-section-titulo">Bubble Tea</h2>
            <span class="home-section-tag">@SharedLocalizer["NuestrasEstrellas"]</span>
        </div>

        <div class="home-grid">

            <div class="home-card">
                <div class="home-card-stripe"></div>
                <div class="home-card-img-wrap">
                    <img src="~/images/productos/Bubble Tea Original_BubbleTea.png" alt="Bubble Tea Original" />
                </div>
                <div class="home-card-body">
                    <span class="home-card-cat">@SharedLocalizer["CatBubbleTea"]</span>
                    <p class="home-card-nombre">Original Bubble Tea</p>
                    <p class="home-card-precio">₡2,500</p>
                </div>
            </div>

            <div class="home-card">
                <div class="home-card-stripe"></div>
                <div class="home-card-img-wrap">
                    <img src="~/images/productos/Bubble Tea Matcha_BubbleTea.png" alt="Matcha Bubble Tea" />
                </div>
                <div class="home-card-body">
                    <span class="home-card-cat">@SharedLocalizer["CatBubbleTea"]</span>
                    <p class="home-card-nombre">Matcha Bubble Tea</p>
                    <p class="home-card-precio">₡2,800</p>
                </div>
            </div>

            <div class="home-card">
                <div class="home-card-stripe"></div>
                <div class="home-card-img-wrap">
                    <img src="~/images/productos/Bubble Tea Taro_BubbleTea.png" alt="Taro Bubble Tea" />
                </div>
                <div class="home-card-body">
                    <span class="home-card-cat">@SharedLocalizer["CatBubbleTea"]</span>
                    <p class="home-card-nombre">Taro Bubble Tea</p>
                    <p class="home-card-precio">₡2,800</p>
                </div>
            </div>

            <div class="home-card">
                <div class="home-card-stripe"></div>
                <div class="home-card-img-wrap">
                    <img src="~/images/productos/OreoBoba_Bubble tea.png" alt="Oreo Boba" />
                </div>
                <div class="home-card-body">
                    <span class="home-card-cat">@SharedLocalizer["CatBubbleTea"]</span>
                    <p class="home-card-nombre">Oreo Boba</p>
                    <p class="home-card-precio">₡3,000</p>
                </div>
            </div>

            <div class="home-card">
                <div class="home-card-stripe"></div>
                <div class="home-card-img-wrap">
                    <img src="~/images/productos/CoffeeBoba _Bubble tea.png" alt="Coffee Boba" />
                </div>
                <div class="home-card-body">
                    <span class="home-card-cat">@SharedLocalizer["CatBubbleTea"]</span>
                    <p class="home-card-nombre">Coffee Boba</p>
                    <p class="home-card-precio">₡3,000</p>
                </div>
            </div>

        </div>
    </div>

    <div class="section-divider"><hr /></div>

    @* Sección Café *@
    <div class="home-section cafes">
        <div class="home-section-header">
            <h2 class="home-section-titulo">@SharedLocalizer["TituloCafes"]</h2>
            <span class="home-section-tag">@SharedLocalizer["TagEspecialidad"]</span>
        </div>

        <div class="home-grid">

            <div class="home-card">
                <div class="home-card-stripe"></div>
                <div class="home-card-img-wrap">
                    <img src="~/images/productos/IcedAmericano_Café.png" alt="Iced Americano" />
                </div>
                <div class="home-card-body">
                    <span class="home-card-cat">@SharedLocalizer["CatCafe"]</span>
                    <p class="home-card-nombre">Iced Americano</p>
                    <p class="home-card-precio">₡2,200</p>
                </div>
            </div>

            <div class="home-card">
                <div class="home-card-stripe"></div>
                <div class="home-card-img-wrap">
                    <img src="~/images/productos/IcedLatte_Café.png" alt="Iced Latte" />
                </div>
                <div class="home-card-body">
                    <span class="home-card-cat">@SharedLocalizer["CatCafe"]</span>
                    <p class="home-card-nombre">Iced Latte</p>
                    <p class="home-card-precio">₡2,500</p>
                </div>
            </div>

            <div class="home-card">
                <div class="home-card-stripe"></div>
                <div class="home-card-img-wrap">
                    <img src="~/images/productos/IcedMocha_Café.png" alt="Iced Mocha" />
                </div>
                <div class="home-card-body">
                    <span class="home-card-cat">@SharedLocalizer["CatCafe"]</span>
                    <p class="home-card-nombre">Iced Mocha</p>
                    <p class="home-card-precio">₡2,700</p>
                </div>
            </div>

        </div>
    </div>

</div>


