<!DOCTYPE html>
<html lang="en">
@using System.Globalization
@using Microsoft.AspNetCore.Builder
@using Microsoft.AspNetCore.Localization
@using Microsoft.Extensions.Options
@using Microsoft.AspNetCore.Mvc.Localization
@using BrewTime.Web
@using System.Security.Claims
@inject BrewTime.Application.Services.Interfaces.IServiceCarrito ServiceCarrito

@inject IOptions<RequestLocalizationOptions> LocOptions
@inject IHtmlLocalizer<SharedResource> SharedLocalizer
@inject BrewTime.Application.Services.Interfaces.IServiceUsuario ServiceUsuario
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BrewTime</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    @RenderSection("Styles", required: false)
    <link rel="stylesheet" href="~/BrewTime.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chatbot.css" asp-append-version="true" />
</head>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

@if (TempData["Success"] != null)
{
    <script>
        Swal.fire({
        icon: 'success',
        title: '@SharedLocalizer["SweetAlert_Success"]',
        text: '@TempData["Success"]',
        confirmButtonColor: '#6F4E37'
        });
    </script>
}

@if (TempData["Error"] != null)
{
    <script>
        Swal.fire({
        icon: 'error',
        title: '@SharedLocalizer["SweetAlert_Error"]',
        text: '@TempData["Error"]',
        confirmButtonColor: '#6F4E37'
        });
    </script>
}

@if (TempData["Warning"] != null)
{
    <script>
        Swal.fire({
        icon: 'warning',
        title: '@SharedLocalizer["SweetAlert_Warning"]',
        text: '@TempData["Warning"]',
        confirmButtonColor: '#6F4E37'
        });
    </script>
}
<body class="brew-body">
    @{
        int cantidadCarrito = 0;

        if (User.Identity?.IsAuthenticated == true &&
        (User.IsInRole("Cliente") || User.IsInRole("Encargado")))
        {
            var idClaim = User.FindFirst(ClaimTypes.NameIdentifier);

            if (idClaim != null &&
            int.TryParse(idClaim.Value, out int usuarioId))
            {
                cantidadCarrito =
                await ServiceCarrito.CantidadItemsAsync(usuarioId);
            }
        }
    }
    <header>
        <nav class="brew-navbar navbar navbar-expand-sm navbar-toggleable-sm">
            <div class="container-fluid">

                <!-- Brand con logo -->
                <a class="brew-brand navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="BrewTime Logo" class="brew-logo-img" />
                    BrewTime
                </a>

                <!-- Toggler mobile -->
                <button class="brew-toggler navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- SELECTOR DE IDIOMA -->
                <ul class="navbar-nav">

                    <li class="nav-item dropdown">

                        <a class="nav-link dropdown-toggle brew-nav-link"
                           href="#"
                           id="languageDropdown"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">

                            <i class="bi bi-translate"></i>

                            @(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "es"
                                ? "ES"
                                : "EN")

                        </a>

                        <ul class="dropdown-menu"
                            aria-labelledby="languageDropdown">

                            <li>
                                <form asp-controller="Language"
                                      asp-action="SetLanguage"
                                      method="post">

                                    <input type="hidden"
                                           name="culture"
                                           value="es-ES" />

                                    <input type="hidden"
                                           name="returnUrl"
                                           value="@Context.Request.Path@Context.Request.QueryString" />

                                    <button type="submit"
                                            class="dropdown-item">

                                        🇪🇸 Español

                                    </button>

                                </form>
                            </li>

                            <li>
                                <form asp-controller="Language"
                                      asp-action="SetLanguage"
                                      method="post">

                                    <input type="hidden"
                                           name="culture"
                                           value="en-US" />

                                    <input type="hidden"
                                           name="returnUrl"
                                           value="@Context.Request.Path@Context.Request.QueryString" />

                                    <button type="submit"
                                            class="dropdown-item">

                                        🇺🇸 English

                                    </button>

                                </form>
                            </li>

                        </ul>

                    </li>

                </ul>

                <!-- Links -->
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 align-items-center flex-wrap">
                        @if (User.Identity!.IsAuthenticated)
                        {
                            var esCliente = User.IsInRole("Cliente");
                            var esEncargado = User.IsInRole("Encargado");
                            var esCocina = User.IsInRole("Cocina");
                            var esAdministrador = User.IsInRole("Administrador");

                            // Pedidos
                            @if (esCliente || esEncargado || esAdministrador)
                            {
                                <li class="nav-item">
                                    <a class="brew-nav-link nav-link"
                                       asp-controller="Pedido"
                                       asp-action="Index">
                                        @SharedLocalizer["Pedidos"]
                                    </a>
                                </li>
                            }

                            // Menus
                            <li class="nav-item dropdown">
                                <a class="brew-nav-link nav-link dropdown-toggle"
                                   href="#"
                                   id="navbarDropdownMenus"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    @SharedLocalizer["Menus"]

                                </a>

                                <ul class="dropdown-menu dropdown-menu-dark"
                                    aria-labelledby="navbarDropdownMenus"
                                    style="background-color:#1a2712;
                   border-color:rgba(201,149,106,0.3);">

                                    <li>
                                        <a class="dropdown-item brew-nav-link"
                                           asp-controller="Menu"
                                           asp-action="Disponible">
                                            @SharedLocalizer["MenuDisponible"]
                                        </a>
                                    </li>

                                    @if (esEncargado || esAdministrador)
                                    {
                                        <li>
                                            <a class="dropdown-item brew-nav-link"
                                               asp-controller="Menu"
                                               asp-action="Index">
                                                @SharedLocalizer["HistorialMenus"]
                                            </a>
                                        </li>
                                    }

                                </ul>
                            </li>

                            // productos y combos
                            <li class="nav-item dropdown">

                                <a class="brew-nav-link nav-link dropdown-toggle"
                                   href="#"
                                   id="navbarDropdownExplorar"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    @SharedLocalizer["Explorar"]

                                </a>

                                <ul class="dropdown-menu dropdown-menu-dark"
                                    aria-labelledby="navbarDropdownExplorar"
                                    style="background-color:#1a2712;
                   border-color:rgba(201,149,106,0.3);">

                                    @if (esCliente || esEncargado || esAdministrador)
                                    {
                                        <li>
                                            <a class="dropdown-item brew-nav-link"
                                               asp-controller="Producto"
                                               asp-action="Index">
                                                @SharedLocalizer["Productos"]
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item brew-nav-link"
                                               asp-controller="Combo"
                                               asp-action="Index">
                                                @SharedLocalizer["Combos"]
                                            </a>
                                        </li>
                                    }

                                    @if (esCocina || esAdministrador)
                                    {
                                        <li>
                                            <a class="dropdown-item brew-nav-link"
                                               asp-controller="ProcesoPreparacion"
                                               asp-action="Index">
                                                @SharedLocalizer["Procesos"]
                                            </a>
                                        </li>
                                    }

                                    @if (esAdministrador || esEncargado)
                                    {
                                        <li>
                                            <a class="dropdown-item brew-nav-link"
                                               asp-controller="Combo"
                                               asp-action="ProductosInconsistentes">
                                                @SharedLocalizer["CombosInconsistentes"]
                                            </a>
                                        </li>
                                    }

                                </ul>
                            </li>

                            @if (User.IsInRole("Administrador") || User.IsInRole("Encargado")) { <li class="nav-item"><a class="brew-nav-link nav-link" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-bar-chart-line"></i> Dashboard</a></li> }
                            @if (User.IsInRole("Administrador"))
                            // usuarios
                            @if (esAdministrador)
                            {
                                <li class="nav-item">

                                    <a class="brew-nav-link nav-link"
                                       asp-controller="Usuario"
                                       asp-action="Index">

                                        @SharedLocalizer["Usuarios"]

                                    </a>

                                </li>
                            }

                            // cocina
                            @if (esCocina)
                            {
                                <li class="nav-item">

                                    <a class="brew-nav-link nav-link"
                                       asp-controller="Cocina"
                                       asp-action="Index">

                                        <i class="bi bi-fire me-1"></i>
                                        @SharedLocalizer["Cocina"]

                                    </a>

                                </li>
                            }

                            // carrito
                            @if (esCliente || esEncargado)
                            {
                                <li class="nav-item me-3">

                                    <a asp-controller="Carrito"
                                       asp-action="Index"
                                       class="position-relative brew-nav-link">

                                        <i class="bi bi-cart3 fs-4"></i>

                                        <span id="cantidadCarrito"
                                              class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                              style="display:@(cantidadCarrito > 0 ? "inline-block" : "none")">

                                            @cantidadCarrito

                                        </span>

                                    </a>

                                </li>
                            }

                            // usuario actual 
                            <li class="nav-item d-flex align-items-center">

                                <span class="brew-nav-link"
                                      style="cursor:default; opacity:0.9;">

                                    @SharedLocalizer["Hola"] @User.Identity.Name

                                </span>

                            </li>

                            // cerrar sesion
                            <li class="nav-item ms-2 ms-auto">

                                <a asp-controller="Login"
                                   asp-action="Logout"
                                   class="brew-logout-btn">

                                    <i class="bi bi-box-arrow-right"></i>

                                    <span>
                                        @SharedLocalizer["CerrarSesion"]
                                    </span>

                                </a>

                            </li>
                        }
                        else
                        {
                            <li class="nav-item">

                                <a asp-controller="Login"
                                   asp-action="Index"
                                   class="brew-nav-link">

                                    @SharedLocalizer["IniciarSesion"]

                                </a>

                            </li>
                        }

                    </ul>
                </div>

            </div>
        </nav>
    </header>

    @* Sin container wrappe, cada vista maneja su propio fondo *@
    <main role="main" class="brew-main">
        @RenderBody()
    </main>

    <footer class="brew-footer">
        <div class="brew-footer-glow"></div>

        <div class="container brew-footer-main">

            <!-- Columna 1: Marca -->
            <div class="brew-footer-col brew-footer-brand-col">
                <span class="brew-footer-brand">☕ BrewTime</span>
                <p class="brew-footer-tagline">@SharedLocalizer["Footer_Tagline"]</p>
                <div class="brew-footer-social">
                    <!-- Iconos sociales omitidos por brevedad visual en este bloque, se mantienen tus originales -->
                    <a href="https://wa.me/50688888888" target="_blank" rel="noopener" class="brew-social-link" aria-label="WhatsApp">
                        <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2zm5.8 14.15c-.24.68-1.4 1.3-1.93 1.38-.5.08-1.13.11-1.82-.11-.42-.13-.96-.31-1.65-.6-2.9-1.25-4.79-4.17-4.94-4.36-.14-.19-1.18-1.57-1.18-3 0-1.42.75-2.12 1.02-2.41.27-.29.58-.36.78-.36.19 0 .39 0 .56.01.18.01.42-.07.65.5.24.58.82 2 .89 2.15.07.14.12.31.02.5-.1.19-.15.31-.29.48-.15.17-.31.38-.44.51-.15.15-.3.31-.13.6.17.29.76 1.25 1.63 2.02 1.12 1 2.06 1.31 2.35 1.46.29.15.46.13.63-.05.17-.19.72-.84.91-1.13.19-.29.38-.24.63-.14.26.1 1.63.77 1.91.91.29.14.48.21.55.33.07.12.07.68-.16 1.36z" /></svg>
                    </a>
                    <a href="https://facebook.com/brewtime" target="_blank" rel="noopener" class="brew-social-link" aria-label="Facebook">
                        <svg viewBox="0 0 24 24"><path fill="currentColor" d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22c4.78-.79 8.44-4.94 8.44-9.94z" /></svg>
                    </a>
                    <a href="https://instagram.com/brewtime" target="_blank" rel="noopener" class="brew-social-link" aria-label="Instagram">
                        <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2.2c3.2 0 3.58.01 4.85.07 1.17.05 1.97.24 2.43.4a4.9 4.9 0 0 1 1.77 1.15 4.9 4.9 0 0 1 1.15 1.77c.16.46.35 1.26.4 2.43.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.24 1.97-.4 2.43a4.9 4.9 0 0 1-1.15 1.77 4.9 4.9 0 0 1-1.77 1.15c-.46.16-1.26.35-2.43.4-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.97-.24-2.43-.4a4.9 4.9 0 0 1-1.77-1.15 4.9 4.9 0 0 1-1.15-1.77c-.16-.46-.35-1.26-.4-2.43C2.21 15.58 2.2 15.2 2.2 12s.01-3.58.07-4.85c.05-1.17.24-1.97.4-2.43a4.9 4.9 0 0 1 1.15-1.77A4.9 4.9 0 0 1 5.59 1.8c.46-.16 1.26-.35 2.43-.4C9.29 1.34 9.67 1.33 12 1.33m0 2c-3.15 0-3.5.01-4.74.07-.98.04-1.5.2-1.85.34-.47.18-.8.4-1.15.75-.35.35-.57.68-.75 1.15-.14.36-.3.87-.34 1.85C3.11 8.4 3.1 8.75 3.1 11.9s.01 3.5.07 4.74c.04.98.2 1.5.34 1.85.18.47.4.8.75 1.15.35.35.68.57 1.15.75.36.14.87.3 1.85.34 1.24.06 1.59.07 4.74.07s3.5-.01 4.74-.07c.98-.04 1.5-.2 1.85-.34.47-.18.8-.4 1.15-.75.35-.35.57-.68.75-1.15.14-.36.3-.87.34-1.85.06-1.24.07-1.59.07-4.74s-.01-3.5-.07-4.74c-.04-.98-.2-1.5-.34-1.85a3 3 0 0 0-.75-1.15 3 3 0 0 0-1.15-.75c-.36-.14-.87-.3-1.85-.34C15.5 3.21 15.15 3.2 12 3.2zm0 3.5a5.3 5.3 0 1 1 0 10.6 5.3 5.3 0 0 1 0-10.6zm0 2a3.3 3.3 0 1 0 0 6.6 3.3 3.3 0 0 0 0-6.6zm5.5-2.1a1.24 1.24 0 1 1-2.48 0 1.24 1.24 0 0 1 2.48 0z" /></svg>
                    </a>
                </div>
            </div>

            <!-- Columna 2: Contacto -->
            <div class="brew-footer-col">
                <h6 class="brew-footer-heading">@SharedLocalizer["Contacto"]</h6>
                <ul class="brew-footer-list">
                    <li>
                        <span class="brew-footer-icon-wrap">
                            <svg viewBox="0 0 24 24"><path fill="currentColor" d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5z" /></svg>
                        </span>
                        BrewTimeCR@hotmail.com
                    </li>
                    <li>
                        <span class="brew-footer-icon-wrap">
                            <svg viewBox="0 0 24 24"><path fill="currentColor" d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.36 11.36 0 0 0 .57 3.57 1 1 0 0 1-.25 1.02z" /></svg>
                        </span>
                        +506 8888-8888
                    </li>
                    <li>
                        <span class="brew-footer-icon-wrap">
                            <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z" /></svg>
                        </span>
                        @SharedLocalizer["Ubicacion"]
                    </li>
                </ul>
            </div>

            <!-- Columna 3: Horario -->
            <div class="brew-footer-col">
                <h6 class="brew-footer-heading">@SharedLocalizer["Horario"]</h6>
                <ul class="brew-footer-list">
                    <li>@SharedLocalizer["Horario_Semana"]</li>
                    <li>@SharedLocalizer["Horario_Sabado"]</li>
                    <li>@SharedLocalizer["Horario_Domingo"]</li>
                </ul>
            </div>
        </div>

        <div class="brew-footer-divider">
            <span class="brew-footer-bean">●</span>
        </div>

        <div class="container brew-footer-bottom">
            <span class="brew-footer-copy">@SharedLocalizer["Footer_Copy"]</span>
            <span class="brew-footer-creators">@SharedLocalizer["HechoCon"] <span class="brew-heart">♥</span> @SharedLocalizer["Por"] <strong>Angélica Solís Sibaja</strong> &amp; <strong>Erin Huang Lin</strong> &amp; <strong>Fabián Zamora Méndez</strong></span>
            <a class="brew-footer-link" asp-area="" asp-controller="Home" asp-action="Privacy">@SharedLocalizer["Privacidad"]</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/chatbot.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>