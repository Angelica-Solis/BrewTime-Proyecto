@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<BrewTime.Web.SharedResource> SharedLocalizer
@*  ChatBot BrewTime  *@
<div id="brew-chatbot">
    <!-- Ventana del Chat -->
    <div id="brew-chat-window">
        <!-- Encabezado -->
        <div class="chat-header">
            <div class="chat-header-info">
                <div class="chat-avatar">
                    <i class="bi bi-cup-hot-fill"></i>
                </div>
                <div class="chat-title">
                    <h5>@SharedLocalizer["Chat_Title"]</h5>
                    <span>
                        @SharedLocalizer["Chat_Status"]
                    </span>
                </div>
            </div>
            <button type="button"
                    id="btnCerrarChat"
                    class="chat-close">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <!-- Conversacion -->
        <div class="chat-body">
            <!-- Mensaje del Bot -->
            <div class="message bot">
                <div class="message-avatar">
                    BT
                </div>
                <div class="message-content">
                    @SharedLocalizer["Chat_WelcomeMsg"]
                </div>
            </div>
            <!-- Mensajes -->
            <div id="chatMessages">
            </div>
        </div>
        <!-- Preguntas rápidas -->
        <div class="chat-options">

            <button type="button" class="quick-question">
                @SharedLocalizer["Combos"]
            </button>

            <button type="button" class="quick-question">
                @SharedLocalizer["Chat_QPayments"]
            </button>

            <button type="button" class="quick-question">
                @SharedLocalizer["Chat_QDelivery"]
            </button>

            <button type="button" class="quick-question">
                @SharedLocalizer["PedidoWord"]
            </button>

        </div>
        <!-- Caja para escribir -->
        <div class="chat-footer">
            <input type="text"
                   id="txtPregunta"
                   placeholder="@SharedLocalizer["Chat_InputPlaceholder"].Value" />
            <button type="button"
                    id="btnEnviar" onclick="enviarMensaje()">
                @SharedLocalizer["Chat_SendBtn"]
            </button>
        </div>
    </div>
    <!-- Burbuja flotante -->
    <button id="btnAbrirChat"
            class="chat-float-button">
        <i class="bi bi-cup-hot-fill"></i>
    </button>
</div>

