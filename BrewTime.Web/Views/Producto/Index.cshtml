@model IEnumerable<BrewTime.Application.DTOs.ProductoDTO>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<BrewTime.Web.SharedResource> SharedLocalizer

@section Styles {
    <link rel="stylesheet" href="~/css/producto.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = SharedLocalizer["ProductosTitulo"].Value;
}

<div class="brew-page">
    @* Chatbot  *@
    <partial name="_Chatbot" />

    @* Hero banner *@
    <div class="brew-hero">
        <div class="brew-hero-inner">
            <p class="brew-hero-eyebrow">@SharedLocalizer["CafeteriaEyebrow"]</p>
            <h1 class="brew-titulo">@SharedLocalizer["Nuestros"] <em>@SharedLocalizer["ProductosTitulo"]</em></h1>
            <p class="brew-subtitulo">@SharedLocalizer["SubtituloProductos"]</p>
            <div class="brew-hero-line">
                <span></span>
                <i>@SharedLocalizer["MenuPrecios"]</i>
                <span></span>
            </div>
            @* Botón de mantenimiento - se ocultará según rol *@
            <div class="brew-hero-actions">
                <a asp-action="Maintenance" class="brew-btn-admin">
                    @SharedLocalizer["AdministrarProductos"]
                </a>
            </div>
        </div>
    </div>

    @* Contenido *@
    <div class="brew-content">

        @if (!Model.Any())
        {
            <div class="brew-grid">
                <div class="brew-empty">
                    <span class="brew-empty-icon">☕</span>
                    <p>@SharedLocalizer["NoHayProductos"]</p>
                </div>
            </div>
        }
        else
        {
            <p class="brew-count">@Model.Count() @SharedLocalizer["ProductosRegistradosCount"]</p>

            <div class="brew-grid">
                @foreach (var item in Model)
                {
                    <div class="brew-card">

                        @* Franja decorativa superior *@
                        <div class="brew-card-stripe"></div>

                        <div class="brew-card-body">

                            @* Fila superior: nombre y precio *@
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <p class="brew-card-producto m-0">@item.Nombre</p>
                                <span class="brew-badge-tiempo">
                                    @item.Precio.ToString("C", new System.Globalization.CultureInfo("es-CR"))
                                </span>
                            </div>

                            @* Descripción *@
                            <p class="brew-card-desc">@item.Descripcion</p>

                            @* Footer: categoría + estado + botón *@
                            <div class="brew-card-footer">
                                <div class="brew-card-footer-left">
                                    <span class="brew-card-chip mb-0">@item.CategoriaNombre</span>
                                    @if (item.Activo)
                                    {
                                        <span class="brew-badge-activo">@SharedLocalizer["Activo"]</span>
                                    }
                                    else
                                    {
                                        <span class="brew-badge-inactivo">@SharedLocalizer["Inactivo"]</span>
                                    }
                                </div>
                                <a asp-action="Detail"
                                   asp-route-id="@item.ProductoID"
                                   class="brew-btn-detalle">
                                    @SharedLocalizer["VerDetalle"]
                                </a>
                            </div>

                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>