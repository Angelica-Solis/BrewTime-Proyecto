@model BrewTime.Application.DTOs.ProductoFormDTO
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<BrewTime.Web.SharedResource> SharedLocalizer

@section Styles {
    <link rel="stylesheet" href="~/css/producto.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = SharedLocalizer["EditarProductoTitulo"].Value;
}

<div class="brew-page">

    <div class="brew-hero">
        <div class="brew-hero-inner">
            <p class="brew-hero-eyebrow">@SharedLocalizer["AdminEyebrow"]</p>
            <h1 class="brew-titulo">@SharedLocalizer["EditarTxt"] <em>@SharedLocalizer["ProductoEm"]</em></h1>
            <p class="brew-subtitulo">@SharedLocalizer["DescEditarProducto"]</p>
            <div class="brew-hero-line">
                <span></span>
                <i>@SharedLocalizer["EdicionProductoLabel"]</i>
                <span></span>
            </div>
        </div>
    </div>

    <div class="brew-content">

        <a asp-action="Maintenance" class="brew-btn-volver">← @SharedLocalizer["VolverMantenimientoBtn"]</a>

        <div class="brew-form-card">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                @* ID oculto para que el POST sepa qué registro actualizar *@
                <input asp-for="ProductoID" type="hidden" />

                @* Cantidad de imágenes actuales, para validar en el POST que quede al menos una *@
                <input asp-for="ImagenesActualesCount" type="hidden" />

                <div class="brew-form-group">
                    <label asp-for="Nombre" class="brew-form-label">@SharedLocalizer["NombreLabel"]</label>
                    <input asp-for="Nombre" class="brew-form-input" />
                    <span asp-validation-for="Nombre" class="brew-form-error"></span>
                </div>

                <div class="brew-form-group">
                    <label asp-for="Descripcion" class="brew-form-label">@SharedLocalizer["DescripcionLabel"]</label>
                    <textarea asp-for="Descripcion" class="brew-form-input brew-form-textarea"></textarea>
                    <span asp-validation-for="Descripcion" class="brew-form-error"></span>
                </div>

                <div class="brew-form-row">

                    <div class="brew-form-group">
                        <label asp-for="Precio" class="brew-form-label">@SharedLocalizer["PrecioColonesLabel"]</label>
                        <input asp-for="Precio" type="number" step="50" min="0"
                               class="brew-form-input" />
                        <span asp-validation-for="Precio" class="brew-form-error"></span>
                    </div>

                    <div class="brew-form-group">
                        <label asp-for="CategoriaID" class="brew-form-label">@SharedLocalizer["CategoriaLabel"]</label>
                        <select asp-for="CategoriaID" asp-items="ViewBag.Categorias" class="brew-form-input">
                            <option value="">@SharedLocalizer["SeleccioneCategoriaOption"]</option>
                        </select>
                        <span asp-validation-for="CategoriaID" class="brew-form-error"></span>
                    </div>

                </div>

                <hr class="my-4" style="border-color: var(--border-card); opacity: 0.5;" />

                <div class="brew-form-group">
                    <label class="brew-form-label">@SharedLocalizer["IngredientesCatalogoLabel"]</label>
                    <p class="brew-form-hint">@SharedLocalizer["SeleccioneIngredientesHint"]</p>

                    @if (ViewBag.IngredientesDisponibles != null && ((IEnumerable<dynamic>)ViewBag.IngredientesDisponibles).Any())
                    {
                        <div class="brew-ingredientes-checklist">
                            @foreach (var ingrediente in ViewBag.IngredientesDisponibles)
                            {
                                <label class="brew-ingrediente-check">
                                    <input type="checkbox"
                                           name="IngredientesSeleccionados"
                                           value="@ingrediente.IngredienteID"
                                    @(Model.IngredientesSeleccionados != null && Model.IngredientesSeleccionados.Contains((int)ingrediente.IngredienteID) ? "checked" : "") />
                                    <span>@ingrediente.Nombre</span>
                                </label>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="brew-ingredientes-vacio">@SharedLocalizer["NoHayIngredientesCatalogo"]</p>
                    }
                </div>

                <div class="brew-form-group">
                    <label class="brew-form-label">@SharedLocalizer["IngredientesNuevosLabel"]</label>
                    <p class="brew-form-hint">@SharedLocalizer["EscribaIngredienteHint"]</p>
                    <div class="brew-ingrediente-nuevo">
                        <input type="text" id="nuevo-ingrediente-input" class="brew-form-input" placeholder="@SharedLocalizer["EjCremaBatidaPlaceholder"].Value" />
                        <button type="button" class="brew-btn-secundario" id="btn-agregar-ingrediente-nuevo">@SharedLocalizer["AgregarBtn"]</button>
                    </div>
                    <div class="brew-ingredientes-nuevos-lista" id="lista-ingredientes-nuevos">
                        @if (Model.IngredientesNuevos != null)
                        {
                            @foreach (var nuevo in Model.IngredientesNuevos)
                            {
                                <div class="brew-chip-ingrediente">
                                    <span>@nuevo</span>
                                    <input type="hidden" name="IngredientesNuevos" value="@nuevo" />
                                    <button type="button" onclick="this.parentElement.remove()">×</button>
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="brew-form-group brew-form-check-group">
                    <input asp-for="Activo" type="checkbox" class="brew-form-check" />
                    <label asp-for="Activo" class="brew-form-label">@SharedLocalizer["ProductoActivoLabel"]</label>
                </div>

                <div class="brew-form-group">
                    <label asp-for="ImagenesNuevas" class="brew-form-label">@SharedLocalizer["ImagenProductoLabel"]</label>

                    @if (Model.ImagenesActuales.Any())
                    {
                        <div class="brew-current-images">
                            @foreach (var imagen in Model.ImagenesActuales)
                            {
                                <label class="brew-current-image">
                                    <img src="@imagen.RutaImagen" alt="@Model.Nombre" />
                                    <span>
                                        <input type="checkbox" name="ImagenesAEliminar" value="@imagen.ImagenID" />
                                        @SharedLocalizer["EliminarBtn"]
                                    </span>
                                </label>
                            }
                        </div>
                    }

                    <div class="brew-upload-box">
                        <div class="brew-upload-icon">IMG</div>
                        <div class="brew-upload-copy">
                            <strong>@SharedLocalizer["AgregarNuevaImagenStrong"]</strong>
                            <span>@SharedLocalizer["HintNuevaImagen"]</span>
                        </div>
                        <input asp-for="ImagenesNuevas" type="file" accept="image/*" class="brew-file-input" />
                    </div>
                    <div class="brew-image-preview" data-image-preview hidden>
                        <img src="" alt="@SharedLocalizer["VistaPreviaImgAlt"].Value" />
                        <span data-image-name></span>
                    </div>
                    <span asp-validation-for="ImagenesNuevas" class="brew-form-error"></span>
                </div>

                <div class="brew-form-footer">
                    <a asp-action="Maintenance" class="brew-btn-volver">@SharedLocalizer["CancelarBtn"]</a>
                    <button type="submit" class="brew-btn-nuevo">@SharedLocalizer["GuardarCambiosBtn"]</button>
                </div>

            </form>
        </div>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.querySelectorAll('.brew-file-input').forEach((input) => {
            input.addEventListener('change', () => {
                const preview = input.closest('.brew-form-group').querySelector('[data-image-preview]');
                const image = preview.querySelector('img');
                const name = preview.querySelector('[data-image-name]');
                const file = input.files && input.files[0];

                if (!file) {
                    image.removeAttribute('src');
                    name.textContent = '';
                    preview.hidden = true;
                    return;
                }

                image.src = URL.createObjectURL(file);
                name.textContent = file.name;
                preview.hidden = false;
            });
        });

        const nuevoInput = document.getElementById('nuevo-ingrediente-input');
        const btnAgregar = document.getElementById('btn-agregar-ingrediente-nuevo');
        const listaNuevos = document.getElementById('lista-ingredientes-nuevos');

        function agregarIngredienteNuevo() {
            const nombre = nuevoInput.value.trim();
            if (!nombre) return;

            // Evitar duplicados en los nuevos
            const existentes = Array.from(listaNuevos.querySelectorAll('input[type="hidden"]'))
                                    .map(inp => inp.value.toLowerCase());
            if (existentes.includes(nombre.toLowerCase())) {
                nuevoInput.value = '';
                return;
            }

            const chip = document.createElement('div');
            chip.className = 'brew-chip-ingrediente';
            chip.innerHTML = `
                <span>${nombre}</span>
                <input type="hidden" name="IngredientesNuevos" value="${nombre}" />
                <button type="button" onclick="this.parentElement.remove()">×</button>
            `;
            listaNuevos.appendChild(chip);
            nuevoInput.value = '';
            nuevoInput.focus();
        }

        if (btnAgregar && nuevoInput) {
            btnAgregar.addEventListener('click', (e) => {
                e.preventDefault();
                agregarIngredienteNuevo();
            });
            nuevoInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    agregarIngredienteNuevo();
                }
            });
        }
    </script>
}
