@model IEnumerable<BrewTime.Application.DTOs.ProductoDTO>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<BrewTime.Web.SharedResource> SharedLocalizer

@{
    var inactivos = ViewBag.Inactivos as IEnumerable<BrewTime.Application.DTOs.ProductoDTO>
                   ?? Enumerable.Empty<BrewTime.Application.DTOs.ProductoDTO>();
    ViewData["Title"] = SharedLocalizer["MantenimientoTitulo"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/producto.css" asp-append-version="true" />
}

<div class="brew-page">

    <div class="brew-hero">
        <div class="brew-hero-inner">
            <p class="brew-hero-eyebrow">@SharedLocalizer["AdminEyebrow"]</p>
            <h1 class="brew-titulo">@SharedLocalizer["MantenimientoTxt"] <em>@SharedLocalizer["ProductosEm"]</em></h1>
            <p class="brew-subtitulo">@SharedLocalizer["DescMantenimiento"]</p>
            <div class="brew-hero-line">
                <span></span><i>@SharedLocalizer["GestionCatalogoLabel"]</i><span></span>
            </div>
        </div>
    </div>

    <div class="brew-content">

        <div class="brew-maint-toolbar">
            <a asp-action="Index" class="brew-btn-volver">← @SharedLocalizer["VolverCatalogoBtn"]</a>
            <a asp-action="Create" class="brew-btn-nuevo">+ @SharedLocalizer["NuevoProductoBtn"]</a>
        </div>

        @* ── PRODUCTOS ACTIVOS ── *@
        <h2 class="brew-section-title">
            <span class="brew-section-dot activo"></span>
            @SharedLocalizer["ProductosActivosTitle"]
            <span class="brew-section-count">@Model.Count()</span>
        </h2>

        @if (!Model.Any())
        {
            <div class="brew-empty"><span class="brew-empty-icon">☕</span><p>@SharedLocalizer["NoProductosActivos"]</p></div>
        }
        else
        {
            <div class="brew-maint-table-wrap">
                <table class="brew-maint-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@SharedLocalizer["NombreLabel"]</th>
                            <th>@SharedLocalizer["CategoriaLabel"]</th>
                            <th>@SharedLocalizer["PrecioLabel"]</th>
                            <th class="text-center">@SharedLocalizer["AccionesCol"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ProductoID</td>
                                <td>@item.Nombre</td>
                                <td><span class="brew-card-chip">@item.CategoriaNombre</span></td>
                                <td>@item.Precio.ToString("C", new System.Globalization.CultureInfo("es-CR"))</td>
                                <td class="brew-maint-actions">
                                    <a asp-action="Edit" asp-route-id="@item.ProductoID"
                                       class="brew-btn-editar">
                                        <i class="bi bi-pencil"></i> @SharedLocalizer["EditarBtn"]
                                    </a>
                                    <form asp-action="ToggleActivo" method="post" style="display:inline">
                                        <input type="hidden" name="id" value="@item.ProductoID" />
                                        <button type="button" class="brew-btn-desactivar btn-toggle-activo" data-nombre="@item.Nombre" data-accion="desactivar">
                                            <i class="bi bi-toggle-on"></i> @SharedLocalizer["DesactivarBtn"]
                                        </button>
                                    </form>
                                    <a asp-action="DetailAdmin" asp-route-id="@item.ProductoID" class="brew-btn-editar">
                                        <i class="bi bi-eye"></i> @SharedLocalizer["VerDetalleBtn"]
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @* ── PRODUCTOS INACTIVOS ── *@
        <h2 class="brew-section-title" style="margin-top:2.5rem;">
            <span class="brew-section-dot inactivo"></span>
            @SharedLocalizer["ProductosInactivosTitle"]
            <span class="brew-section-count">@inactivos.Count()</span>
        </h2>

        @if (!inactivos.Any())
        {
            <div class="brew-empty"><span class="brew-empty-icon">✓</span><p>@SharedLocalizer["NoProductosInactivos"]</p></div>
        }
        else
        {
            <div class="brew-maint-table-wrap brew-table-inactiva">
                <table class="brew-maint-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>@SharedLocalizer["NombreLabel"]</th>
                            <th>@SharedLocalizer["CategoriaLabel"]</th>
                            <th>@SharedLocalizer["PrecioLabel"]</th>
                            <th class="text-center">@SharedLocalizer["AccionesCol"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in inactivos)
                        {
                            <tr class="brew-row-inactiva">
                                <td>@item.ProductoID</td>
                                <td>@item.Nombre</td>
                                <td><span class="brew-card-chip">@item.CategoriaNombre</span></td>
                                <td>@item.Precio.ToString("C", new System.Globalization.CultureInfo("es-CR"))</td>
                                <td class="brew-maint-actions">
                                    <form asp-action="ToggleActivo" method="post" style="display:inline">
                                        <input type="hidden" name="id" value="@item.ProductoID" />
                                        <button type="button" class="brew-btn-activar btn-toggle-activo" data-nombre="@item.Nombre" data-accion="activar">
                                            <i class="bi bi-toggle-off"></i> @SharedLocalizer["ActivarBtn"]
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.querySelectorAll('.btn-toggle-activo').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const form = this.closest('form');
                const nombre = this.getAttribute('data-nombre');
                const accion = this.getAttribute('data-accion');
                const esDesactivar = accion === 'desactivar';

                const textDesactivar = '@SharedLocalizer["SwalTextDesactivar"].Value'.replace('{0}', nombre);
                const textActivar = '@SharedLocalizer["SwalTextActivar"].Value'.replace('{0}', nombre);

                Swal.fire({
                    title: esDesactivar ? '@SharedLocalizer["SwalTitleDesactivar"].Value' : '@SharedLocalizer["SwalTitleActivar"].Value',
                    text: esDesactivar ? textDesactivar : textActivar,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: esDesactivar ? '#8a2020' : '#243318',
                    cancelButtonColor: '#5a3e28',
                    confirmButtonText: esDesactivar ? '@SharedLocalizer["SwalConfirmDesactivar"].Value' : '@SharedLocalizer["SwalConfirmActivar"].Value',
                    cancelButtonText: '@SharedLocalizer["CancelarBtn"].Value',
                    background: '#f0e2cc',
                    color: '#2e1e0e'
                }).then((result) => {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });
    </script>
}