@model BrewTime.Application.DTOs.UsuarioDetalleDTO
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<BrewTime.Web.SharedResource> SharedLocalizer

@section Styles {
    <link rel="stylesheet" href="~/css/usuario.css" asp-append-version="true" />
}
@{
    ViewData["Title"] = SharedLocalizer["DetalleUsuarioTitulo"].Value;
    var iniciales = $"{Model.Nombre[0]}{Model.Apellidos[0]}";
}

<div class="brew-page">

    <section class="brew-hero">
        <div class="brew-hero-inner">
            <p class="brew-hero-eyebrow">@SharedLocalizer["AdministracionEyebrow"]</p>

            <h1 class="brew-titulo">
                @SharedLocalizer["PerfilDeTxt"] <em>@SharedLocalizer["UsuarioEm"]</em>
            </h1>

            <p class="brew-subtitulo">
                @SharedLocalizer["DescDetalleUsuario"]
            </p>

            <div class="brew-hero-line">
                <span></span>
                <i>BrewTime</i>
                <span></span>
            </div>
        </div>
    </section>

    <div class="brew-content">

        <div class="brew-detail-container">

            <div class="brew-detail-card">

                <div class="brew-detail-header">

                    <div class="brew-detail-avatar">
                        @iniciales
                    </div>

                    <div class="brew-detail-name">
                        @Model.Nombre @Model.Apellidos
                    </div>

                    <div class="brew-detail-role">
                        <span class="brew-card-chip">
                            @Model.NombreRol
                        </span>
                    </div>

                </div>

                <div class="brew-detail-body">

                    <div class="brew-detail-grid">

                        <div class="brew-detail-field">
                            <div class="brew-detail-label">
                                @SharedLocalizer["CorreoLabel"]
                            </div>
                            <div class="brew-detail-value">
                                @Model.Correo
                            </div>
                        </div>

                        <div class="brew-detail-field">
                            <div class="brew-detail-label">
                                @SharedLocalizer["TelefonoLabel"]
                            </div>
                            <div class="brew-detail-value">
                                @(string.IsNullOrWhiteSpace(Model.Telefono)
                                    ? SharedLocalizer["NoRegistrado"].Value
                                    : Model.Telefono)
                            </div>
                        </div>

                        <div class="brew-detail-field">
                            <div class="brew-detail-label">
                                @SharedLocalizer["RolLabel"]
                            </div>
                            <div class="brew-detail-value">
                                <span class="brew-card-chip">
                                    @Model.NombreRol
                                </span>
                            </div>
                        </div>

                        <div class="brew-detail-field">
                            <div class="brew-detail-label">
                                @SharedLocalizer["EstadoLabel"]
                            </div>
                            <div class="brew-detail-value">

                                @if (Model.Activo)
                                {
                                    <span class="brew-badge-estado activo">
                                        @SharedLocalizer["ActivoBadge"]
                                    </span>
                                }
                                else
                                {
                                    <span class="brew-badge-estado inactivo">
                                        @SharedLocalizer["InactivoBadge"]
                                    </span>
                                }

                            </div>
                        </div>

                    </div>

                    <div class="brew-detail-footer">
                        <a asp-action="Index"
                           class="brew-btn-volver">
                            @SharedLocalizer["VolverListadoBtn"]
                        </a>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>