@model IEnumerable<BrewTime.Application.DTOs.UsuarioDTO>

@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<BrewTime.Web.SharedResource> SharedLocalizer

@section Styles {
    <link rel="stylesheet"
          href="~/css/usuario.css"
          asp-append-version="true" />
}

@{
    ViewData["Title"] = "Gestión de usuarios";
}

<div class="brew-page">

    <section class="brew-hero">

        <div class="brew-hero-inner">

            <p class="brew-hero-eyebrow">
                Administración
            </p>

            <h1 class="brew-titulo">
                Gestión de <em>usuarios</em>
            </h1>

            <p class="brew-subtitulo">
                Consulta, busca, crea y modifica los usuarios registrados.
            </p>

            <div class="brew-hero-line">
                <span></span>
                <i>BrewTime</i>
                <span></span>
            </div>

        </div>

    </section>

    <div class="brew-content">

        <!-- encabezado -->
        <div class="d-flex justify-content-between
                    align-items-center flex-wrap gap-3 mb-4">

            <div class="brew-count mb-0">
                Total de usuarios: @Model.Count()
            </div>

            <a asp-action="Create"
               class="brew-btn-detalle">

                <i class="bi bi-person-plus me-1"></i>

                Crear usuario

            </a>

        </div>

        <!-- buscador -->
        <div class="brew-detail-card mb-4">

            <div class="brew-detail-body">

                <form asp-action="Index"
                      method="get">

                    <div class="row g-3 align-items-end">

                        <div class="col-md-10">

                            <label class="brew-detail-label">
                                Buscar usuario
                            </label>

                            <input type="text"
                                   name="buscar"
                                   value="@ViewBag.Buscar"
                                   class="form-control brew-input"
                                   placeholder="Nombre, apellidos o rol..." />

                        </div>

                        <div class="col-md-2">

                            <button type="submit"
                                    class="brew-btn-detalle"
                                    style="border:none; width:100%; justify-content:center; cursor:pointer;">

                                <i class="bi bi-search me-1"></i>

                                Buscar

                            </button>

                        </div>

                    </div>

                </form>

            </div>

        </div>

        <!-- tabla -->
        @if (Model.Any())
        {
            <div class="brew-table-wrapper">

                <div class="brew-table-stripe"></div>

                <table class="brew-table">

                    <thead>

                        <tr>

                            <th>
                                Nombre
                            </th>

                            <th>
                                Rol
                            </th>

                            <th>
                                Estado
                            </th>

                            <th>
                                Acciones
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var usuario in Model)
                        {
                            <tr>

                                <td class="brew-td-nombre">

                                    @usuario.Nombre
                                    @usuario.Apellidos

                                </td>

                                <td>

                                    <span class="brew-card-chip">
                                        @usuario.NombreRol
                                    </span>

                                </td>

                                <td>

                                    @if (usuario.Activo)
                                    {
                                        <span class="brew-badge-estado activo">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="brew-badge-estado inactivo">
                                            Inactivo
                                        </span>
                                    }

                                </td>

                                <td>

                                    <div class="d-flex justify-content-end gap-2">

                                        <a asp-action="Detail"
                                           asp-route-id="@usuario.UsuarioId"
                                           class="brew-btn-detalle">

                                            Ver

                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@usuario.UsuarioId"
                                           class="brew-btn-detalle">

                                            Editar

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="brew-empty">

                <i class="bi bi-people fs-1 d-block mb-3"></i>

                <h5>
                    No se encontraron usuarios
                </h5>

                <p>
                    Prueba con otro criterio de búsqueda.
                </p>

            </div>
        }

    </div>

</div>