@model IEnumerable<BrewTime.Application.DTOs.UsuarioDTO>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<BrewTime.Web.SharedResource> SharedLocalizer

@section Styles {
    <link rel="stylesheet" href="~/css/usuario.css" asp-append-version="true" />
}
@{
    ViewData["Title"] = SharedLocalizer["ListadoUsuariosTitulo"].Value;
}
<div class="brew-page">
    <section class="brew-hero">
        <div class="brew-hero-inner">
            <p class="brew-hero-eyebrow">@SharedLocalizer["AdministracionEyebrow"]</p>
            <h1 class="brew-titulo">
                @SharedLocalizer["ListadoDeTxt"] <em>@SharedLocalizer["UsuariosEm"]</em>
            </h1>
            <p class="brew-subtitulo">
                @SharedLocalizer["DescUsuarios"]
            </p>
            <div class="brew-hero-line">
                <span></span>
                <i>BrewTime</i>
                <span></span>
            </div>
        </div>
    </section>
    <div class="brew-content">
        <div class="brew-count">
            @SharedLocalizer["TotalUsuarios"] @Model.Count()
        </div>
        @if (Model.Any())
        {
            <div class="brew-table-wrapper">
                <div class="brew-table-stripe"></div>
                <table class="brew-table">
                    <thead>
                        <tr>
                            <th>@SharedLocalizer["NombreLabel"]</th>
                            <th>@SharedLocalizer["RolLabel"]</th>
                            <th>@SharedLocalizer["EstadoLabel"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var usuario in Model)
                        {
                            <tr>
                                <td class="brew-td-nombre">
                                    @usuario.Nombre @usuario.Apellidos
                                </td>
                                <td>
                                    <span class="brew-card-chip">
                                        @usuario.NombreRol
                                    </span>
                                </td>
                                <td>
                                    @if (usuario.Activo)
                                    {
                                        <span class="brew-badge-estado activo">
                                            @SharedLocalizer["ActivoBadge"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="brew-badge-estado inactivo">
                                            @SharedLocalizer["InactivoBadge"]
                                        </span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Detail"
                                       asp-route-id="@usuario.UsuarioId"
                                       class="brew-btn-detalle">
                                        @SharedLocalizer["VerDetalleBtn"]
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="brew-empty">
                @SharedLocalizer["NoUsuariosRegistrados"]
            </div>
        }
    </div>
</div>