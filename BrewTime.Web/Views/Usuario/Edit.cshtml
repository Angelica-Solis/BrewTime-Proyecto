@model BrewTime.Application.DTOs.UsuarioEditDTO

@section Styles {
    <link rel="stylesheet"
          href="~/css/usuario.css"
          asp-append-version="true" />
}

@{
    ViewData["Title"] = "Editar usuario";
}

<div class="brew-page">

    <section class="brew-hero">

        <div class="brew-hero-inner">

            <p class="brew-hero-eyebrow">
                Administración
            </p>

            <h1 class="brew-titulo">
                Editar <em>usuario</em>
            </h1>

            <p class="brew-subtitulo">
                Actualiza la información, rol o estado
                del usuario seleccionado.
            </p>

            <div class="brew-hero-line">
                <span></span>
                <i>BrewTime</i>
                <span></span>
            </div>

        </div>

    </section>

    <div class="brew-content">

        <div class="brew-detail-container">

            <div class="brew-detail-card"
                 style="max-width: 780px;">

                <div class="brew-detail-header">

                    <div class="brew-detail-avatar">
                        <i class="bi bi-person-gear"></i>
                    </div>

                    <div class="brew-detail-name">
                        Editar usuario
                    </div>

                    <div class="brew-detail-role">
                        <span class="brew-card-chip">
                            ID: @Model.UsuarioId
                        </span>
                    </div>

                </div>

                <div class="brew-detail-body">

                    <form asp-action="Edit"
                          method="post">

                        <input asp-for="UsuarioId"
                               type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger mb-4">
                        </div>

                        <div class="row g-4">

                            <div class="col-md-6">

                                <label asp-for="Nombre"
                                       class="brew-detail-label">
                                    Nombre
                                </label>

                                <input asp-for="Nombre"
                                       class="form-control brew-input" />

                                <span asp-validation-for="Nombre"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="Apellidos"
                                       class="brew-detail-label">
                                    Apellidos
                                </label>

                                <input asp-for="Apellidos"
                                       class="form-control brew-input" />

                                <span asp-validation-for="Apellidos"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="Correo"
                                       class="brew-detail-label">
                                    Correo electrónico
                                </label>

                                <input asp-for="Correo"
                                       type="email"
                                       class="form-control brew-input" />

                                <span asp-validation-for="Correo"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="Telefono"
                                       class="brew-detail-label">
                                    Teléfono
                                </label>

                                <input asp-for="Telefono"
                                       class="form-control brew-input" />

                                <span asp-validation-for="Telefono"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="NombreRol"
                                       class="brew-detail-label">
                                    Rol
                                </label>

                                <select asp-for="NombreRol"
                                        class="form-select brew-input">

                                    @foreach (string rol
                                    in ViewBag.Roles)
                                    {
                                        <option value="@rol">
                                            @rol
                                        </option>
                                    }

                                </select>

                                <span asp-validation-for="NombreRol"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-md-6">

                                <label class="brew-detail-label">
                                    Estado
                                </label>

                                <div class="form-check mt-2">

                                    <input asp-for="Activo"
                                           class="form-check-input" />

                                    <label asp-for="Activo"
                                           class="form-check-label">
                                        Usuario activo
                                    </label>

                                </div>

                            </div>

                            <div class="col-12">

                                <hr />

                                <h5 style="font-family: var(--font-display);">
                                    Cambiar contraseña
                                </h5>

                                <p class="text-muted small">
                                    Deja los campos vacíos para conservar
                                    la contraseña actual.
                                </p>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="Password"
                                       class="brew-detail-label">
                                    Nueva contraseña
                                </label>

                                <input asp-for="Password"
                                       type="password"
                                       class="form-control brew-input" />

                                <span asp-validation-for="Password"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="ConfirmarPassword"
                                       class="brew-detail-label">
                                    Confirmar contraseña
                                </label>

                                <input asp-for="ConfirmarPassword"
                                       type="password"
                                       class="form-control brew-input" />

                                <span asp-validation-for="ConfirmarPassword"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                        <div class="brew-detail-footer"
                             style="justify-content: flex-end; gap: 0.75rem;">

                            <a asp-action="Index"
                               class="brew-btn-volver">
                                Cancelar
                            </a>

                            <button type="submit"
                                    class="brew-btn-detalle"
                                    style="border: none; cursor: pointer;">
                                Guardar cambios
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}