@model BrewTime.Application.DTOs.RegistroClienteDTO

@section Styles {
    <link rel="stylesheet"
          href="~/css/usuario.css"
          asp-append-version="true" />
}

@{
    ViewData["Title"] = "Registrarse";
}

<div class="brew-page">

    <section class="brew-hero"
             style="padding-bottom: 2.5rem;">

        <div class="brew-hero-inner"
             style="text-align:center;">

            <p class="brew-hero-eyebrow">
                BrewTime
            </p>

            <h1 class="brew-titulo">
                Crear <em>cuenta</em>
            </h1>

            <p class="brew-subtitulo">
                Regístrate para realizar pedidos y consultar
                tu historial.
            </p>

            <div class="brew-hero-line"
                 style="justify-content:center;">

                <span></span>
                <i>Cliente</i>
                <span></span>

            </div>

        </div>

    </section>

    <div class="brew-content"
         style="padding-top: 2rem;">

        <div class="brew-detail-container">

            <div class="brew-detail-card"
                 style="max-width: 650px;">

                <div class="brew-detail-header">

                    <div class="brew-detail-avatar">
                        <i class="bi bi-person-plus"></i>
                    </div>

                    <div class="brew-detail-name">
                        Registro de cliente
                    </div>

                    <div class="brew-detail-role">

                        <span class="brew-card-chip">
                            Rol: Cliente
                        </span>

                    </div>

                </div>

                <div class="brew-detail-body">

                    <form asp-action="Register"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger mb-4">
                        </div>

                        <div class="row g-4">

                            <div class="col-md-6">

                                <label asp-for="Nombre"
                                       class="brew-detail-label">
                                    Nombre
                                </label>

                                <input asp-for="Nombre"
                                       class="form-control brew-input"
                                       autocomplete="given-name" />

                                <span asp-validation-for="Nombre"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="Apellidos"
                                       class="brew-detail-label">
                                    Apellidos
                                </label>

                                <input asp-for="Apellidos"
                                       class="form-control brew-input"
                                       autocomplete="family-name" />

                                <span asp-validation-for="Apellidos"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-12">

                                <label asp-for="Correo"
                                       class="brew-detail-label">
                                    Correo electrónico
                                </label>

                                <input asp-for="Correo"
                                       type="email"
                                       class="form-control brew-input"
                                       autocomplete="email"
                                       placeholder="ejemplo@correo.com" />

                                <span asp-validation-for="Correo"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-12">

                                <label asp-for="Telefono"
                                       class="brew-detail-label">
                                    Teléfono
                                </label>

                                <input asp-for="Telefono"
                                       class="form-control brew-input"
                                       autocomplete="tel"
                                       placeholder="8888-8888" />

                                <span asp-validation-for="Telefono"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="Password"
                                       class="brew-detail-label">
                                    Contraseña
                                </label>

                                <input asp-for="Password"
                                       type="password"
                                       class="form-control brew-input"
                                       autocomplete="new-password" />

                                <span asp-validation-for="Password"
                                      class="text-danger small">
                                </span>

                                <small class="text-muted d-block mt-2">
                                    Mínimo 8 caracteres,
                                    con mayúscula, minúscula y número.
                                </small>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="ConfirmarPassword"
                                       class="brew-detail-label">
                                    Confirmar contraseña
                                </label>

                                <input asp-for="ConfirmarPassword"
                                       type="password"
                                       class="form-control brew-input"
                                       autocomplete="new-password" />

                                <span asp-validation-for="ConfirmarPassword"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                        <div class="mt-4 p-3"
                             style="background: rgba(60,90,35,0.08);
                                    border: 1px solid rgba(60,90,35,0.15);
                                    border-radius: 10px;">

                            <strong>
                                <i class="bi bi-shield-check"></i>
                                Registro seguro
                            </strong>

                            <p class="small mb-0 mt-1">
                                El sistema asignará automáticamente
                                el rol Cliente. El usuario no puede
                                seleccionar otro rol.
                            </p>

                        </div>

                        <div class="brew-detail-footer"
                             style="justify-content: flex-end; gap: 0.75rem;">

                            <a asp-controller="Login"
                               asp-action="Index"
                               class="brew-btn-volver">
                                Volver al login
                            </a>

                            <button type="submit"
                                    class="brew-btn-detalle"
                                    style="border: none; cursor: pointer;">
                                Crear cuenta
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}