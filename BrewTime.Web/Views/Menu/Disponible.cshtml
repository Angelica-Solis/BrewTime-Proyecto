@model BrewTime.Application.DTOs.MenuDTO?
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<BrewTime.Web.SharedResource> SharedLocalizer

@section Styles {
    <link rel="stylesheet"
          href="~/css/Menu.css"
          asp-append-version="true" />
}

@{
    ViewData["Title"] = SharedLocalizer["MenuDisponibleTitulo"].Value;

    string NombreDia(byte dia)
    {
        return dia switch
        {
            1 => SharedLocalizer["Lunes"].Value,
            2 => SharedLocalizer["Martes"].Value,
            3 => SharedLocalizer["Miercoles"].Value,
            4 => SharedLocalizer["Jueves"].Value,
            5 => SharedLocalizer["Viernes"].Value,
            6 => SharedLocalizer["Sabado"].Value,
            7 => SharedLocalizer["Domingo"].Value,
            _ => SharedLocalizer["DiaNoDefinido"].Value
        };
    }
}

<div class="menu-page">
    @* Chatbot  *@
    <partial name="_Chatbot" />
    <section class="menu-hero">
        <div class="menu-hero-inner">
            <p class="menu-eyebrow">@SharedLocalizer["CafeteriaEyebrow"]</p>

            <h1 class="menu-title">
                @SharedLocalizer["MenuTxt"] <em>@SharedLocalizer["DisponibleEm"]</em>
            </h1>

            <p class="menu-subtitle">
                @SharedLocalizer["DisfrutaSeleccion"]
            </p>
        </div>
    </section>

    <main class="menu-content menu-available-content">

        @if (Model == null)
        {
            <div class="menu-detail-card">
                <div class="menu-detail-body">
                    <p class="menu-empty">
                        @SharedLocalizer["NoMenuDisponibleFecha"]
                    </p>
                </div>
            </div>
        }
        else
        {
            var menu = Model;

            <section class="menu-restaurant-card menu-modern-board">

                <div class="menu-restaurant-header menu-modern-header">

                    <p class="menu-board-label">
                        @SharedLocalizer["MenuActiveLabel"]
                    </p>

                    <h2 class="menu-board-title">
                        @menu.Nombre
                    </h2>

                    @if (!string.IsNullOrWhiteSpace(menu.Descripcion))
                    {
                        <p class="menu-board-description">
                            @menu.Descripcion
                        </p>
                    }

                    <div class="menu-range menu-modern-range">

                        <div class="menu-range-item">
                            <span>@SharedLocalizer["HorarioLabel"]</span>

                            <strong>
                                @menu.HoraInicio.ToString("HH:mm")
                                -
                                @menu.HoraFin.ToString("HH:mm")
                            </strong>
                        </div>

                        <div class="menu-range-item">
                            <span>@SharedLocalizer["FechasLabel"]</span>

                            <strong>
                                @if (menu.FechaInicio.HasValue &&
                               menu.FechaFin.HasValue)
                                {
                                    @($"{menu.FechaInicio.Value:dd/MM/yyyy} - {menu.FechaFin.Value:dd/MM/yyyy}")
                                }
                                else
                                {
                                    @SharedLocalizer["NoDefinido"]
                                }
                            </strong>
                        </div>

                        <div class="menu-range-item">
                            <span>@SharedLocalizer["DiasTxt"]</span>

                            <strong>
                                @if (menu.MenuDiaSemana != null &&
                               menu.MenuDiaSemana.Any())
                                {
                                    @string.Join(
                                             ", ",
                                             menu.MenuDiaSemana
                                             .OrderBy(x => x.DiaSemana)
                                             .Select(x =>
                                             NombreDia(x.DiaSemana)))
                                }
                                else
                                {
                                    @SharedLocalizer["NoDiasConfigurados"]
                                }
                            </strong>
                        </div>

                    </div>
                </div>

                <div class="menu-restaurant-body menu-modern-body">

                    @if (menu.MenuProducto != null &&
                   menu.MenuProducto.Any(x =>
                   x.Producto != null))
                    {
                        <div class="menu-section-block">

                            <h3 class="menu-modern-section-title">
                                @SharedLocalizer["ProductosTitle"]
                            </h3>

                            @{
                                var productosAgrupados =
                                menu.MenuProducto
                                .Where(x => x.Producto != null)
                                .GroupBy(x =>
                                string.IsNullOrWhiteSpace(
                                x.Producto.CategoriaNombre)
                                ? SharedLocalizer["SinCategoria"].Value
                                : x.Producto.CategoriaNombre)
                                .OrderBy(x => x.Key)
                                .ToList();
                            }

                            @foreach (var grupo in productosAgrupados)
                            {
                                <div class="menu-category-block">

                                    <h4 class="menu-category-title menu-modern-category-title">
                                        @grupo.Key
                                    </h4>

                                    <div class="menu-modern-grid">

                                        @foreach (var item in grupo)
                                        {
                                            <article class="menu-list-item">

                                                <div class="menu-list-info">@if (!string.IsNullOrWhiteSpace(item.Producto.RutaImagenPrincipal)) { <img src="@item.Producto.RutaImagenPrincipal" class="menu-item-image" alt="@item.Producto.Nombre" /> }@if (!string.IsNullOrWhiteSpace(item.Producto.RutaImagenPrincipal)) { <img src="@item.Producto.RutaImagenPrincipal" class="menu-item-image" alt="@item.Producto.Nombre" /> }

                                                    <div class="menu-list-title-row">

                                                        <h5>
                                                            @item.Producto.Nombre
                                                        </h5>

                                                        <span></span>

                                                        <strong class="menu-price">
                                                            ₡@item.Producto.Precio.ToString("N2")
                                                        </strong>

                                                    </div>

                                                    @if (!string.IsNullOrWhiteSpace(
                                                   item.Producto.Descripcion))
                                                    {
                                                        <p>
                                                            @item.Producto.Descripcion
                                                        </p>
                                                    }

                                                </div>

                                            </article>
                                        }

                                    </div>

                                </div>
                            }

                        </div>
                    }

                    @if (menu.MenuCombo != null &&
                   menu.MenuCombo.Any(x =>
                   x.Combo != null))
                    {
                        <div class="menu-section-block">

                            <h3 class="menu-modern-section-title">
                                @SharedLocalizer["CombosTitle"]
                            </h3>

                            @{
                                var combosAgrupados =
                                menu.MenuCombo
                                .Where(x => x.Combo != null)
                                .GroupBy(x =>
                                string.IsNullOrWhiteSpace(
                                x.Combo.CategoriaNombre)
                                ? SharedLocalizer["SinCategoria"].Value
                                : x.Combo.CategoriaNombre)
                                .OrderBy(x => x.Key)
                                .ToList();
                            }

                            @foreach (var grupo in combosAgrupados)
                            {
                                <div class="menu-category-block">

                                    <h4 class="menu-category-title menu-modern-category-title">
                                        @grupo.Key
                                    </h4>

                                    <div class="menu-modern-grid">

                                        @foreach (var item in grupo)
                                        {
                                            <article class="menu-list-item">

                                                <div class="menu-list-info">@if (!string.IsNullOrWhiteSpace(item.Combo.RutaImagen)) { <img src="@item.Combo.RutaImagen" class="menu-item-image" alt="@item.Combo.Nombre" /> }@if (!string.IsNullOrWhiteSpace(item.Combo.RutaImagen)) { <img src="@item.Combo.RutaImagen" class="menu-item-image" alt="@item.Combo.Nombre" /> }

                                                    <div class="menu-list-title-row">

                                                        <h5>
                                                            @item.Combo.Nombre
                                                        </h5>

                                                        <span></span>

                                                        <strong class="menu-price">
                                                            ₡@item.Combo.PrecioEspecial.ToString("N2")
                                                        </strong>

                                                    </div>

                                                    @if (!string.IsNullOrWhiteSpace(
                                                   item.Combo.Descripcion))
                                                    {
                                                        <p>
                                                            @item.Combo.Descripcion
                                                        </p>
                                                    }

                                                </div>

                                            </article>
                                        }

                                    </div>

                                </div>
                            }

                        </div>
                    }

                    @if ((menu.MenuProducto == null ||
                   !menu.MenuProducto.Any(x =>
                   x.Producto != null)) &&
                   (menu.MenuCombo == null ||
                   !menu.MenuCombo.Any(x =>
                   x.Combo != null)))
                    {
                        <p class="menu-empty">
                            @SharedLocalizer["NoProductosCombos"]
                        </p>
                    }

                </div>

            </section>
        }

    </main>
</div>