@model IEnumerable<BrewTime.Application.DTOs.MenuDTO>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<BrewTime.Web.SharedResource> SharedLocalizer

@section Styles {
    <link rel="stylesheet"
          href="~/css/Menu.css"
          asp-append-version="true" />
}

@{
    ViewData["Title"] = SharedLocalizer["Title_MenuMaintenance"];

    var menusActivos = Model
    .Where(x => x.Activo)
    .OrderByDescending(x => x.FechaInicio)
    .ThenByDescending(x => x.FechaCreacion)
    .ToList();

    var menusInactivos = Model
        .Where(x => !x.Activo)
        .OrderByDescending(x => x.FechaInicio)
        .ThenByDescending(x => x.FechaCreacion)
        .ToList();
}

<div class="menu-page">

    <div class="menu-hero">
        <div class="menu-hero-inner">

            <p class="menu-eyebrow">
                @SharedLocalizer["BrewTimeAdministration"]
            </p>

            <h1 class="menu-title">
                @SharedLocalizer["MaintenanceOf"] <em>@SharedLocalizer["MenusItalic"]</em>
            </h1>

            <p class="menu-subtitle">
                @SharedLocalizer["HeroSubtitle"]
            </p>

            <div class="menu-hero-line">
                <span></span>
                <i>@SharedLocalizer["AdministrativeManagement"]</i>
                <span></span>
            </div>

        </div>
    </div>

    <div class="menu-content">

        <div class="menu-maintenance-toolbar">

            <div>
                <h2>@SharedLocalizer["RegisteredMenus"]</h2>
                <p>
                    @SharedLocalizer["TotalOf"] @(menusActivos.Count + menusInactivos.Count) @SharedLocalizer["MenusRegisteredSuffix"]
                </p>
            </div>

            <div class="menu-maintenance-toolbar-actions">
                <a asp-action="Create"
                   class="menu-btn-create">
                    <span>＋</span>
                    @SharedLocalizer["CreateMenu"]
                </a>
            </div>

        </div>

        @if (!menusActivos.Any())
        {
            <div class="menu-detail-card">
                <div class="menu-detail-body">
                    <p class="menu-empty">
                        @SharedLocalizer["NoActiveMenusRegistered"]
                    </p>
                </div>
            </div>
        }
        else
        {
            <div class="menu-section-heading">
                <div class="menu-section-title">
                    <span class="menu-section-dot"></span>
                    <h2>@SharedLocalizer["ActiveMenus"]</h2>
                </div>
                <span class="menu-section-count">
                    @menusActivos.Count
                </span>
            </div>

            <div class="menu-maintenance-list">
                @foreach (var item in menusActivos)
                {
                    <article class="menu-maintenance-card">
                        <div class="menu-maintenance-stripe"></div>
                        <div class="menu-maintenance-main">
                            <div class="menu-maintenance-info">
                                <div class="menu-maintenance-title-row">
                                    <h3>@item.Nombre</h3>
                                    <span class="menu-badge-active">
                                        @SharedLocalizer["BadgeActive"]
                                    </span>
                                </div>

                                <p class="menu-maintenance-description">
                                    @(string.IsNullOrWhiteSpace(item.Descripcion)
                                        ? SharedLocalizer["NoDescriptionRegistered"].Value
                                        : item.Descripcion)
                                </p>

                                <div class="menu-maintenance-meta">
                                    <div class="menu-maintenance-meta-item">
                                        <span>@SharedLocalizer["Dates"]</span>
                                        <strong>
                                            @if (item.FechaInicio.HasValue && item.FechaFin.HasValue)
                                            {
                                                @($"{item.FechaInicio.Value:dd/MM/yyyy} - {item.FechaFin.Value:dd/MM/yyyy}")
                                            }
                                            else
                                            {
                                                @SharedLocalizer["NotDefined"]
                                            }
                                        </strong>
                                    </div>

                                    <div class="menu-maintenance-meta-item">
                                        <span>@SharedLocalizer["Schedule"]</span>
                                        <strong>
                                            @item.HoraInicio.ToString("HH:mm") - @item.HoraFin.ToString("HH:mm")
                                        </strong>
                                    </div>

                                    <div class="menu-maintenance-meta-item">
                                        <span>@SharedLocalizer["Products"]</span>
                                        <strong>@(item.MenuProducto?.Count ?? 0)</strong>
                                    </div>

                                    <div class="menu-maintenance-meta-item">
                                        <span>@SharedLocalizer["Combos"]</span>
                                        <strong>@(item.MenuCombo?.Count ?? 0)</strong>
                                    </div>
                                </div>
                            </div>

                            <div class="menu-maintenance-actions">
                                <a asp-action="Detail"
                                   asp-route-id="@item.MenuId"
                                   class="menu-action-detail">
                                    @SharedLocalizer["Detail"]
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.MenuId"
                                   class="menu-btn-editar">
                                    <i class="bi bi-pencil"></i>
                                    @SharedLocalizer["Edit"]
                                </a>

                                <form asp-action="ToggleActivo"
                                      asp-route-id="@item.MenuId"
                                      method="post"
                                      class="form-toggle-menu">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="menu-btn-desactivar"
                                            data-nombre="@item.Nombre"
                                            data-accion="desactivar">
                                        <i class="bi bi-toggle-on"></i>
                                        @SharedLocalizer["Deactivate"]
                                    </button>
                                </form>
                            </div>
                        </div>
                    </article>
                }
            </div>

            <div class="menu-inactive-section">
                <div class="menu-section-heading">
                    <div class="menu-section-title">
                        <span class="menu-section-dot"></span>
                        <h2>@SharedLocalizer["InactiveMenus"]</h2>
                    </div>
                    <span class="menu-section-count">
                        @menusInactivos.Count
                    </span>
                </div>

                @if (!menusInactivos.Any())
                {
                    <div class="menu-empty-state">
                        <i class="bi bi-journal-text menu-empty-state-icon"></i>
                        <p>@SharedLocalizer["NoInactiveMenus"]</p>
                    </div>
                }
                else
                {
                    <div class="menu-maintenance-list">
                        @foreach (var item in menusInactivos)
                        {
                            <article class="menu-maintenance-card menu-maintenance-card-inactive">
                                <div class="menu-maintenance-main">
                                    <div class="menu-maintenance-info">
                                        <div class="menu-maintenance-title-row">
                                            <h3>@item.Nombre</h3>
                                            <span class="menu-badge-inactive">
                                                @SharedLocalizer["BadgeInactive"]
                                            </span>
                                        </div>

                                        <p class="menu-maintenance-description">
                                            @(string.IsNullOrWhiteSpace(item.Descripcion)
                                                ? SharedLocalizer["NoDescriptionRegistered"].Value
                                                : item.Descripcion)
                                        </p>

                                        <div class="menu-maintenance-meta">
                                            <div class="menu-maintenance-meta-item">
                                                <span>@SharedLocalizer["Dates"]</span>
                                                <strong>
                                                    @if (item.FechaInicio.HasValue && item.FechaFin.HasValue)
                                                    {
                                                        @($"{item.FechaInicio.Value:dd/MM/yyyy} - {item.FechaFin.Value:dd/MM/yyyy}")
                                                    }
                                                    else
                                                    {
                                                        @SharedLocalizer["NotDefined"]
                                                    }
                                                </strong>
                                            </div>

                                            <div class="menu-maintenance-meta-item">
                                                <span>@SharedLocalizer["Schedule"]</span>
                                                <strong>
                                                    @item.HoraInicio.ToString("HH:mm") - @item.HoraFin.ToString("HH:mm")
                                                </strong>
                                            </div>

                                            <div class="menu-maintenance-meta-item">
                                                <span>@SharedLocalizer["Products"]</span>
                                                <strong>@(item.MenuProducto?.Count ?? 0)</strong>
                                            </div>

                                            <div class="menu-maintenance-meta-item">
                                                <span>@SharedLocalizer["Combos"]</span>
                                                <strong>@(item.MenuCombo?.Count ?? 0)</strong>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="menu-maintenance-actions">
                                        <a asp-action="Detail"
                                           asp-route-id="@item.MenuId"
                                           class="menu-action-detail">
                                            @SharedLocalizer["Detail"]
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.MenuId"
                                           class="menu-btn-editar">
                                            <i class="bi bi-pencil"></i>
                                            @SharedLocalizer["Edit"]
                                        </a>

                                        <form asp-action="ToggleActivo"
                                              asp-route-id="@item.MenuId"
                                              method="post"
                                              class="form-toggle-menu">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="menu-btn-activar"
                                                    data-nombre="@item.Nombre"
                                                    data-accion="activar">
                                                <i class="bi bi-toggle-off"></i>
                                                @SharedLocalizer["Activate"]
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const mensajeExito = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["MensajeExito"]?.ToString()));
            const mensajeError = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["MensajeError"]?.ToString()));
            const tituloMensaje = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["TituloMensaje"]?.ToString()));

            // Textos traducidos inyectados desde Razor hacia JavaScript
            const txtSuccessTitle = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(SharedLocalizer["SwalSuccessTitle"].Value));
            const txtErrorTitle = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(SharedLocalizer["SwalErrorTitle"].Value));
            const txtAcceptButton = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(SharedLocalizer["SwalAcceptButton"].Value));
            const txtDeactivateMenuTitle = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(SharedLocalizer["SwalDeactivateMenuTitle"].Value));
            const txtActivateMenuTitle = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(SharedLocalizer["SwalActivateMenuTitle"].Value));
            const txtYesDeactivate = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(SharedLocalizer["SwalYesDeactivate"].Value));
            const txtYesActivate = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(SharedLocalizer["SwalYesActivate"].Value));
            const txtCancel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(SharedLocalizer["SwalCancel"].Value));
            const txtConfirmDeactivateText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(SharedLocalizer["SwalConfirmDeactivateText"].Value));
            const txtConfirmActivateText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(SharedLocalizer["SwalConfirmActivateText"].Value));

            if (mensajeExito) {
                Swal.fire({
                    icon: "success",
                    title: tituloMensaje || txtSuccessTitle,
                    text: mensajeExito,
                    confirmButtonText: txtAcceptButton,
                    confirmButtonColor: "#243318"
                });
            }

            if (mensajeError) {
                Swal.fire({
                    icon: "error",
                    title: tituloMensaje || txtErrorTitle,
                    text: mensajeError,
                    confirmButtonText: txtAcceptButton,
                    confirmButtonColor: "#8a3030"
                });
            }

            document.querySelectorAll(".form-toggle-menu").forEach(function (formulario) {
                formulario.addEventListener("submit", function (event) {
                    event.preventDefault();
                    const boton = formulario.querySelector("button");
                    const nombre = boton.dataset.nombre;
                    const accion = boton.dataset.accion;
                    const esDesactivar = accion === "desactivar";

                    Swal.fire({
                        icon: "warning",
                        title: esDesactivar ? txtDeactivateMenuTitle : txtActivateMenuTitle,
                        text: esDesactivar ? txtConfirmDeactivateText.replace("{0}", nombre) : txtConfirmActivateText.replace("{0}", nombre),
                        showCancelButton: true,
                        confirmButtonText: esDesactivar ? txtYesDeactivate : txtYesActivate,
                        cancelButtonText: txtCancel,
                        reverseButtons: true,
                        confirmButtonColor: esDesactivar ? "#8a3030" : "#344d24",
                        cancelButtonColor: "#8a6848"
                    }).then(function (resultado) {
                        if (resultado.isConfirmed) {
                            formulario.submit();
                        }
                    });
                });
            });
        });
    </script>
}