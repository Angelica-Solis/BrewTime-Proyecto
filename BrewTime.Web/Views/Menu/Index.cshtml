@model IEnumerable<BrewTime.Application.DTOs.MenuDTO>
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<BrewTime.Web.SharedResource> SharedLocalizer

@section Styles {
    <link rel="stylesheet" href="~/css/Menu.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = SharedLocalizer["ListadoMenusTitulo"].Value;

    var menus = Model
        .OrderByDescending(x => x.FechaInicio)
        .ThenByDescending(x => x.HoraInicio)
        .ThenByDescending(x => x.FechaCreacion)
        .ToList();
}

<div class="menu-page">

    <div class="menu-hero">
        <div class="menu-hero-inner">
            <p class="menu-eyebrow">@SharedLocalizer["AdminEyebrow"]</p>
            <h1 class="menu-title">@SharedLocalizer["ListadoDeTxt"] <em>@SharedLocalizer["MenusEm"]</em></h1>
            <p class="menu-subtitle">
                @SharedLocalizer["DescListadoMenus"]
            </p>

            @* Botón de mantenimiento; posteriormente puede ocultarse según el rol *@
            @if (User.IsInRole("Administrador") || User.IsInRole("Encargado"))
            {
                <div class="menu-hero-actions">
                    <a asp-action="Maintenance"
                       class="menu-btn-admin">
                        @SharedLocalizer["AdministrarMenusBtn"]
                    </a>
                </div>
            }

        </div>
    </div>

    <div class="menu-content">

        @if (!menus.Any())
        {
            <div class="menu-detail-card">
                <div class="menu-detail-body">
                    <p class="menu-empty">@SharedLocalizer["NoMenusRegistrados"]</p>
                </div>
            </div>
        }
        else
        {
            <p class="menu-count-text">
                @menus.Count @SharedLocalizer["MenusRegistradosSufijo"]
            </p>

            <div class="menu-table-card menu-index-card">

                <div class="menu-index-header">
                    <div>
                        <p class="menu-index-label">@SharedLocalizer["MenusRegistradosLabel"]</p>
                        <h2>@SharedLocalizer["ListadoGeneralLabel"]</h2>
                    </div>
                </div>

                <table class="menu-table menu-index-table">
                    <thead>
                        <tr>
                            <th>@SharedLocalizer["MenuLabel"]</th>
                            <th>@SharedLocalizer["HorarioLabel"]</th>
                            <th>@SharedLocalizer["DisponibilidadLabel"]</th>
                            <th>@SharedLocalizer["EstadoLabel"]</th>
                            <th>@SharedLocalizer["AccionLabel"]</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in menus)
                        {
                            <tr>
                                <td>
                                    <span class="menu-table-title">@item.Nombre</span>

                                    @if (!string.IsNullOrWhiteSpace(item.Descripcion))
                                    {
                                        <span class="menu-small-text">@item.Descripcion</span>
                                    }
                                    else
                                    {
                                        <span class="menu-small-text">@SharedLocalizer["SinDescripcion"]</span>
                                    }
                                </td>

                                <td>
                                    <span class="menu-table-main">
                                        @item.HoraInicio.ToString("HH:mm") - @item.HoraFin.ToString("HH:mm")
                                    </span>
                                </td>

                                <td>
                                    @if (item.FechaInicio != null && item.FechaFin != null)
                                    {
                                        <span class="menu-table-main">
                                            @item.FechaInicio.Value.ToString("dd/MM/yyyy")
                                        </span>
                                        <span class="menu-small-text">
                                            @SharedLocalizer["HastaTxt"] @item.FechaFin.Value.ToString("dd/MM/yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="menu-small-text">@SharedLocalizer["NoDefinido"]</span>
                                    }
                                </td>

                                <td>
                                    @if (item.Activo)
                                    {
                                        <span class="menu-badge-active">@SharedLocalizer["DisponibleBadge"]</span>
                                    }
                                    else
                                    {
                                        <span class="menu-badge-inactive">@SharedLocalizer["InactivoBadge"]</span>
                                    }
                                </td>

                                <td>
                                    <a asp-action="Detail"
                                       asp-route-id="@item.MenuId"
                                       class="menu-btn">
                                        @SharedLocalizer["DetalleBtn"]
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>