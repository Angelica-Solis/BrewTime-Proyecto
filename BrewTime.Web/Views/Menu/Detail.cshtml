@model BrewTime.Application.DTOs.MenuDTO
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<BrewTime.Web.SharedResource> SharedLocalizer

@section Styles {
    <link rel="stylesheet" href="~/css/Menu.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = SharedLocalizer["DetalleMenuTitulo"].Value;

    string NombreDia(byte dia)
    {
        return dia switch
        {
            1 => SharedLocalizer["Lunes"].Value,
            2 => SharedLocalizer["Martes"].Value,
            3 => SharedLocalizer["Miercoles"].Value,
            4 => SharedLocalizer["Jueves"].Value,
            5 => SharedLocalizer["Viernes"].Value,
            6 => SharedLocalizer["Sabado"].Value,
            7 => SharedLocalizer["Domingo"].Value,
            _ => SharedLocalizer["DiaNoDefinido"].Value
        };
    }
}

<div class="menu-page">
    @* Chatbot  *@
    <partial name="_Chatbot" />
    <div class="menu-hero">
        <div class="menu-hero-inner">
            <p class="menu-eyebrow">@SharedLocalizer["CafeteriaEyebrow"]</p>
            <h1 class="menu-title">@SharedLocalizer["DetalleDelTxt"] <em>@SharedLocalizer["MenuEm"]</em></h1>
            <p class="menu-subtitle">
                @SharedLocalizer["DescDetalleMenu"]
            </p>
        </div>
    </div>

    <div class="menu-content">

        <a asp-action="Maintenance" class="menu-btn-secondary">
            ← @SharedLocalizer["VolverListadoBtn"]
        </a>

        <div class="menu-detail-card">
            <div class="menu-detail-body">

                <h2 class="menu-detail-title menu-detail-main-title">
                    @Model.Nombre
                </h2>

                <p class="menu-lead">
                    @Model.Descripcion
                </p>

                <div class="menu-info-grid">

                    <div class="menu-info-item">
                        <span class="menu-info-label">@SharedLocalizer["HorarioLabel"]</span>
                        <span class="menu-info-value">
                            @Model.HoraInicio.ToString("HH:mm") - @Model.HoraFin.ToString("HH:mm")
                        </span>
                    </div>

                    <div class="menu-info-item">
                        <span class="menu-info-label">@SharedLocalizer["FechasLabel"]</span>
                        <span class="menu-info-value">
                            @if (Model.FechaInicio != null && Model.FechaFin != null)
                            {
                                <span>
                                    @Model.FechaInicio.Value.ToString("dd/MM/yyyy")
                                    -
                                    @Model.FechaFin.Value.ToString("dd/MM/yyyy")
                                </span>
                            }
                            else
                            {
                                <span>@SharedLocalizer["NoDefinido"]</span>
                            }
                        </span>
                    </div>

                    <div class="menu-info-item">
                        <span class="menu-info-label">@SharedLocalizer["EstadoLabel"]</span>
                        <span class="menu-info-value">
                            @if (Model.Activo)
                            {
                                <span class="menu-badge-active">@SharedLocalizer["ActivoBadge"]</span>
                            }
                            else
                            {
                                <span class="menu-badge-inactive">@SharedLocalizer["InactivoBadge"]</span>
                            }
                        </span>
                    </div>

                </div>

                <h2 class="menu-detail-title">
                    @SharedLocalizer["DiasTxt"] <em>@SharedLocalizer["DisponiblesEm"]</em>
                </h2>

                @if (Model.MenuDiaSemana != null && Model.MenuDiaSemana.Any())
                {
                    <div class="menu-days-list">
                        @foreach (var dia in Model.MenuDiaSemana.OrderBy(x => x.DiaSemana))
                        {
                            <span class="menu-day-chip">@NombreDia(dia.DiaSemana)</span>
                        }
                    </div>
                }
                else
                {
                    <p class="menu-empty">@SharedLocalizer["NoDiasRegistrados"]</p>
                }

            </div>
        </div>

        <h2 class="menu-detail-title">
            @SharedLocalizer["ProductosDelTxt"] <em>@SharedLocalizer["MenuEm"]</em>
        </h2>

        @if (Model.MenuProducto != null && Model.MenuProducto.Any())
        {
            <div class="menu-table-wrapper">
                <table class="menu-table">
                    <thead>
                        <tr>
                            <th>@SharedLocalizer["ProductoLabel"]</th>
                            <th>@SharedLocalizer["CategoriaLabel"]</th>
                            <th>@SharedLocalizer["PrecioLabel"]</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.MenuProducto)
                        {
                            <tr>
                                <td>
                                    <span class="menu-table-title">
                                        @item.Producto.Nombre
                                    </span>
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Producto.CategoriaNombre))
                                    {
                                        <span class="menu-category-chip">
                                            @item.Producto.CategoriaNombre
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="menu-category-chip menu-category-chip-empty">
                                            @SharedLocalizer["SinCategoria"]
                                        </span>
                                    }
                                </td>

                                <td>
                                    <span class="menu-price-text">
                                        ₡@item.Producto.Precio.ToString("N2")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="menu-detail-card">
                <div class="menu-detail-body">
                    <p class="menu-empty">@SharedLocalizer["NoProductosRegistrados"]</p>
                </div>
            </div>
        }

        <h2 class="menu-detail-title">
            @SharedLocalizer["CombosDelTxt"] <em>@SharedLocalizer["MenuEm"]</em>
        </h2>

        @if (Model.MenuCombo != null && Model.MenuCombo.Any())
        {
            <div class="menu-table-wrapper">
                <table class="menu-table">
                    <thead>
                        <tr>
                            <th>@SharedLocalizer["ComboLabel"]</th>
                            <th>@SharedLocalizer["CategoriaLabel"]</th>
                            <th>@SharedLocalizer["PrecioEspecialLabel"]</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.MenuCombo)
                        {
                            <tr>
                                <td>
                                    <span class="menu-table-title">
                                        @item.Combo.Nombre
                                    </span>
                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Combo.CategoriaNombre))
                                    {
                                        <span class="menu-category-chip">
                                            @item.Combo.CategoriaNombre
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="menu-category-chip menu-category-chip-empty">
                                            @SharedLocalizer["SinCategoria"]
                                        </span>
                                    }
                                </td>

                                <td>
                                    <span class="menu-price-text">
                                        ₡@item.Combo.PrecioEspecial.ToString("N2")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="menu-detail-card">
                <div class="menu-detail-body">
                    <p class="menu-empty">@SharedLocalizer["NoCombosRegistrados"]</p>
                </div>
            </div>
        }

    </div>
</div>